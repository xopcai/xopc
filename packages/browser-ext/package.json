{
  "name": "@xopcai/browser-ext",
  "version": "0.0.1",
  "private": true,
  "description": "Chrome Extension bridge for xopc browser automation — connects to xopc via WebSocket, executes commands in real Chrome via CDP.",
  "type": "module",
  "scripts": {
    "icons": "node scripts/render-icons.mjs",
    "dev": "node scripts/render-icons.mjs && vite build --watch",
    "build": "node scripts/render-icons.mjs && vite build && node scripts/validate-build.mjs",
    "pack": "node ../../scripts/sync-browser-ext-version.mjs && pnpm run build && node scripts/pack-zip.mjs",
    "pack:zip": "node scripts/pack-zip.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xopcai/browser-control-contract": "workspace:*",
    "@xopcai/endpoint-tools-client": "workspace:*",
    "@xopcai/endpoint-tools-protocol": "workspace:*",
    "@xopcai/gateway-contract": "workspace:*",
    "@xopcai/realtime-client": "workspace:*",
    "@xopcai/realtime-protocol": "workspace:*",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "adm-zip": "^0.6.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
