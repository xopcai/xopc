{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "xopc",
  "version": "0.0.264",
  "description": "Chat with xopc and explicitly share or control the current page.",
  "key": "",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "scripting",
    "tabs",
    "tabGroups",
    "activeTab",
    "alarms",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_permissions": [
    "debugger"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "dist/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open xopc",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
