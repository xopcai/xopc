{
  "name": "drive files list",
  "description": "List items in folder",
  "inputSchema": {
    "type": "object",
    "required": [],
    "properties": {
      "params": {
        "type": "object",
        "properties": {
          "direction": {
            "type": "string",
            "description": "定义清单中文件的排序规则，与 order_by 配合使用",
            "flag": "--direction",
            "enum": [
              "ASC",
              "DESC"
            ],
            "enumDescriptions": [
              "Ascending order",
              "Descending order"
            ],
            "default": "DESC",
            "example": "DESC"
          },
          "folder_token": {
            "type": "string",
            "description": "Folder's token. (If this parameter is not provided or an empty string is provided, then return the list of the user's cloud space, and pagination and return shortcuts are not supported. )",
            "flag": "--folder-token",
            "example": "fldbcRho46N6MQ3mJkOAuPabcef"
          },
          "option": {
            "type": "string",
            "description": "指定获取文件清单的特殊方式",
            "flag": "--option",
            "example": "get_all_children_unsort"
          },
          "order_by": {
            "type": "string",
            "description": "定义清单中文件的排序方式",
            "flag": "--order-by",
            "enum": [
              "EditedTime",
              "CreatedTime"
            ],
            "enumDescriptions": [
              "Order by edited time",
              "Order by created time"
            ],
            "default": "EditedTime",
            "example": "EditedTime"
          },
          "page_size": {
            "type": "integer",
            "description": "指定每页显示的数据项的数量，默认值为100。若获取根目录下的清单，将返回全部数据",
            "flag": "--page-size",
            "example": 50,
            "maximum": 200
          },
          "page_token": {
            "type": "string",
            "description": "分页标记，第一次请求不填，表示从头开始遍历；分页查询结果还有更多项时会同时返回新的 page_token，下次遍历可采用该 page_token 获取查询结果",
            "flag": "--page-token",
            "example": "MTY1NTA3MTA1OXw3MTA4NDc2MDc1NzkyOTI0Nabcef"
          },
          "user_id_type": {
            "type": "string",
            "description": "此次调用中使用的用户ID的类型",
            "flag": "--user-id-type",
            "enum": [
              "user_id",
              "union_id",
              "open_id"
            ],
            "enumDescriptions": [
              "以user_id来识别用户",
              "以union_id来识别用户",
              "以open_id来识别用户"
            ]
          }
        }
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "files": {
        "type": "array",
        "description": "List of files in the folder",
        "items": {
          "type": "object",
          "required": [
            "name",
            "token",
            "type"
          ],
          "properties": {
            "created_time": {
              "type": "string",
              "description": "File created time",
              "example": "1686125119"
            },
            "modified_time": {
              "type": "string",
              "description": "File edited time",
              "example": "1686125119"
            },
            "name": {
              "type": "string",
              "description": "文件名",
              "example": "测试"
            },
            "owner_id": {
              "type": "string",
              "description": "File owner",
              "example": "ou_b13d41c02edc52ce66aaae67bf1abcef"
            },
            "parent_token": {
              "type": "string",
              "description": "父文件夹标识",
              "example": "fldcnP8B5Fpr3UwVi24JykpuOic"
            },
            "shortcut_info": {
              "type": "object",
              "description": "Shortcut file information",
              "required": [
                "target_token",
                "target_type"
              ],
              "properties": {
                "target_token": {
                  "type": "string",
                  "description": "The original file token that the shortcut points to",
                  "example": "docxO1UuPz8VwnpPx5a9abcef"
                },
                "target_type": {
                  "type": "string",
                  "description": "The original file type that the shortcut points to",
                  "example": "docx"
                }
              }
            },
            "token": {
              "type": "string",
              "description": "文件标识符",
              "example": "fldcnP8B5Fpr3UwVi24JykpuOic"
            },
            "type": {
              "type": "string",
              "description": "文件类型",
              "example": "docx"
            },
            "url": {
              "type": "string",
              "description": "在浏览器中查看的链接",
              "example": "https://sample.feishu.cn/drive/folder/fldcnExampleFolder"
            }
          }
        }
      },
      "has_more": {
        "type": "boolean",
        "description": "是否还有更多项",
        "example": true
      },
      "next_page_token": {
        "type": "string",
        "description": "Paging tag, when has_more is true, the next_page_token of the next traversal will be returned at the same time, otherwise it will not be returned",
        "example": "MTY1NTA3MTA1OXw3MTA4NDc2MDc1NzkyOTI0Nabcef"
      }
    }
  },
  "_meta": {
    "envelope_version": "1.0",
    "scopes": [
      "drive:drive",
      "drive:drive:readonly",
      "space:document:retrieve"
    ],
    "required_scopes": [],
    "access_tokens": [
      "bot",
      "user"
    ],
    "danger": false,
    "risk": "read",
    "doc_url": "https://open.feishu.cn/document/uAjLw4CM/ukTMukTMukTM/reference/drive-v1/file/list"
  }
}
