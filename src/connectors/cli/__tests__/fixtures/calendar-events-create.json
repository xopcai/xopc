{
  "name": "calendar events create",
  "description": "Create an event",
  "inputSchema": {
    "type": "object",
    "required": [
      "data",
      "params"
    ],
    "properties": {
      "params": {
        "type": "object",
        "required": [
          "calendar_id"
        ],
        "properties": {
          "calendar_id": {
            "type": "string",
            "description": "Calendar ID.; The calendar ID is returned when creating a shared calendar. You can also call the following interface to obtain the ID of a certain calendar.;- Query primary calendar information;- Query calendar list;- Search calendar",
            "flag": "--calendar-id",
            "example": "feishu.cn_xxxxxxxxxx@group.calendar.feishu.cn"
          },
          "idempotency_key": {
            "type": "string",
            "description": "Create an idempotent key for the event. This key is unique under the application and calendar dimensions and is used to avoid repeated creation of resources. It is recommended to follow the format of the example value",
            "flag": "--idempotency-key",
            "example": "25fdf41b-8c80-2ce1-e94c-de8b5e7aa7e6"
          },
          "user_id_type": {
            "type": "string",
            "description": "此次调用中使用的用户ID的类型",
            "flag": "--user-id-type",
            "enum": [
              "user_id",
              "union_id",
              "open_id"
            ],
            "enumDescriptions": [
              "以user_id来识别用户",
              "以union_id来识别用户",
              "以open_id来识别用户"
            ]
          }
        }
      },
      "data": {
        "type": "object",
        "carrier": "--data",
        "required": [
          "end_time",
          "start_time"
        ],
        "properties": {
          "attachments": {
            "type": "array",
            "description": "日程附件",
            "items": {
              "type": "object",
              "properties": {
                "file_token": {
                  "type": "string",
                  "description": "附件 Token。调用“上传素材”接口，获取附件的 file_token。在调用上传素材接口时需要注意：; - `parent_type` 需传入固定值 `calendar`。;- `parent_node` 需传入与当前接口一致的日历 ID。; 附件校验规则：附件总大小不超过 25 MB",
                  "example": "xAAAAA"
                }
              }
            }
          },
          "attendee_ability": {
            "type": "string",
            "description": "参与人权限。; 默认值：none",
            "enum": [
              "none",
              "can_see_others",
              "can_invite_others",
              "can_modify_event"
            ],
            "enumDescriptions": [
              "无法编辑日程、无法邀请其它参与人、无法查看参与人列表",
              "无法编辑日程、无法邀请其它参与人、可以查看参与人列表",
              "无法编辑日程、可以邀请其它参与人、可以查看参与人列表",
              "可以编辑日程、可以邀请其它参与人、可以查看参与人列表"
            ]
          },
          "color": {
            "type": "integer",
            "description": "日程颜色，颜色RGB值的int32表示。仅对当前身份生效；客户端展示时会映射到色板上最接近的一种颜色；值为0或-1时默认跟随日历颜色",
            "example": 0
          },
          "description": {
            "type": "string",
            "description": "日程描述（纯文本）。与 description_rich 互斥，二者至多传其一；推荐统一使用 description_rich（Markdown，兼容纯文本且支持富文本）。切勿与 description_rich 同时传，否则接口会报互斥错误",
            "example": "日程描述"
          },
          "description_rich": {
            "type": "string",
            "description": "日程描述，Markdown 富文本（推荐创建/更新日程统一使用本字段）。与纯文本 description 互斥，二者至多传其一，切勿同时传。支持加粗、斜体、下划线（<u>...</u>）、删除线、链接 文本、标题（# 到 ###，最多三级）、引用（> ）、有序/无序列表、GFM 表格、图片 !alt。飞书文档 URL 会自动解析为内联文档。注意：图片仅支持传入已上传的图片 URL，本地图片不会自动上传；需要本地图片自动上传请改用 lark-cli calendar +create 快捷命令",
            "example": "**重点**：见 [设计文档](https://sample.feishu.cn/docx/example)"
          },
          "end_time": {
            "type": "object",
            "description": "Event end time",
            "properties": {
              "date": {
                "type": "string",
                "description": "Specify the end time in days, in RFC 3339 format, for example, 2018-09-01.; Note: This parameter cannot be specified at the same time as `timestamp`",
                "example": "2018-09-01"
              },
              "timestamp": {
                "type": "string",
                "description": "Second-level timestamp refers to the specific end time. For example, 1602504000 means 2020/10/12 20:00:00 (UTC +8 time zone).; Note: This parameter cannot be specified at the same time as `date`",
                "example": "1602504000"
              },
              "timezone": {
                "type": "string",
                "description": "Time zone. Use IANA Time Zone Database standards such as Asia/Shanghai.; - The time zone is fixed to UTC +0 throughout the day;- The non-all-day time zone defaults to Asia/Shanghai",
                "example": "Asia/Shanghai"
              }
            }
          },
          "event_check_in": {
            "type": "object",
            "description": "日程签到设置，为空则不进行日程签到设置",
            "required": [
              "enable_check_in"
            ],
            "properties": {
              "check_in_end_time": {
                "type": "object",
                "description": "Event check-in end time.; Note: The check-in start time cannot be greater than or equal to the check-in end time",
                "required": [
                  "duration",
                  "time_type"
                ],
                "properties": {
                  "duration": {
                    "type": "integer",
                    "description": "相对于日程开始或者结束的偏移量(分钟)。;- 目前取值只能为列表[0, 5, 15, 30, 60]之一，0表示立即开始。;- 当time_type为before_event_start，duration不能取0",
                    "example": 0,
                    "minimum": 0,
                    "maximum": 60
                  },
                  "time_type": {
                    "type": "string",
                    "description": "偏移量(分钟)相对于的日程时间节点类型",
                    "enum": [
                      "before_event_start",
                      "after_event_start",
                      "after_event_end"
                    ],
                    "enumDescriptions": [
                      "Before the start of event",
                      "After the start of event",
                      "After the end of event"
                    ]
                  }
                }
              },
              "check_in_start_time": {
                "type": "object",
                "description": "Event check-in start time.; Note: The check-in start time cannot be greater than or equal to the check-in end time",
                "required": [
                  "duration",
                  "time_type"
                ],
                "properties": {
                  "duration": {
                    "type": "integer",
                    "description": "相对于日程开始或者结束的偏移量(分钟)。;- 目前取值只能为列表[0, 5, 15, 30, 60]之一，0表示立即开始。;- 当time_type为before_event_start，duration不能取0",
                    "example": 0,
                    "minimum": 0,
                    "maximum": 60
                  },
                  "time_type": {
                    "type": "string",
                    "description": "偏移量(分钟)相对于的日程时间节点类型",
                    "enum": [
                      "before_event_start",
                      "after_event_start",
                      "after_event_end"
                    ],
                    "enumDescriptions": [
                      "Before the start of event",
                      "After the start of event",
                      "After the end of event"
                    ]
                  }
                }
              },
              "enable_check_in": {
                "type": "boolean",
                "description": "是否启用日程签到",
                "example": true
              },
              "need_notify_attendees": {
                "type": "boolean",
                "description": "签到开始时是否自动发送签到通知给参与者"
              }
            }
          },
          "free_busy_status": {
            "type": "string",
            "description": "日程占用的忙闲状态，新建日程默认为Busy；仅新建日程时对所有参与人生效，之后修改该属性仅对当前身份生效",
            "enum": [
              "busy",
              "free"
            ],
            "enumDescriptions": [
              "忙碌",
              "空闲"
            ]
          },
          "location": {
            "type": "object",
            "description": "日程地点",
            "properties": {
              "address": {
                "type": "string",
                "description": "地点地址",
                "example": "普通市和平区世纪大道1号"
              },
              "latitude": {
                "type": "number",
                "description": "地点坐标纬度信息，对于国内的地点，采用GCJ-02标准，海外地点采用WGS84标准",
                "example": 31.239702224731445
              },
              "longitude": {
                "type": "number",
                "description": "地点坐标经度信息，对于国内的地点，采用GCJ-02标准，海外地点采用WGS84标准",
                "example": 121.49971771240234
              },
              "name": {
                "type": "string",
                "description": "地点名称",
                "example": "东方明珠"
              }
            }
          },
          "need_notification": {
            "type": "boolean",
            "description": "Whether to send Bot notifications to event attendees when updating the event.; Optional values are:;- true: send notifications;- false: do not send notifications; Default value: true",
            "example": false
          },
          "recurrence": {
            "type": "string",
            "description": "重复日程的重复性规则，规则设置方式参考 rfc5545。; 默认值：空，表示当前日程不是重复日程。; 注意：;- COUNT 和 UNTIL 不支持同时出现。;- 预定会议室重复日程长度不得超过两年",
            "example": "FREQ=DAILY;INTERVAL=1"
          },
          "reminders": {
            "type": "array",
            "description": "日程提醒列表",
            "items": {
              "type": "object",
              "properties": {
                "minutes": {
                  "type": "integer",
                  "description": "日程提醒时间的偏移量，正数时表示在日程开始前X分钟提醒，负数时表示在日程开始后X分钟提醒;新建或更新日程时传入该字段，仅对当前身份生效",
                  "example": 5,
                  "minimum": -20160,
                  "maximum": 20160
                }
              }
            }
          },
          "schemas": {
            "type": "array",
            "description": "日程自定义信息",
            "items": {
              "type": "object",
              "properties": {
                "app_link": {
                  "type": "string",
                  "description": "按钮点击后跳转的链接。; 注意：兼容性参数，只读，因此暂不支持传入该请求参数",
                  "example": "xxxx"
                },
                "ui_name": {
                  "type": "string",
                  "description": "UI 项名称",
                  "example": "xxx"
                },
                "ui_status": {
                  "type": "string",
                  "description": "UI项自定义状态",
                  "enum": [
                    "hide",
                    "readonly",
                    "editable",
                    "unknown"
                  ],
                  "enumDescriptions": [
                    "隐藏显示",
                    "只读",
                    "可编辑",
                    "未知UI项自定义状态，仅用于读取时兼容"
                  ]
                }
              }
            }
          },
          "source": {
            "type": "string",
            "description": "日程source",
            "example": "source"
          },
          "start_time": {
            "type": "object",
            "description": "Event start time",
            "properties": {
              "date": {
                "type": "string",
                "description": "Specify the start time in days, in RFC 3339 format, for example, 2018-09-01.; Note: This parameter cannot be specified at the same time as `timestamp`",
                "example": "2018-09-01"
              },
              "timestamp": {
                "type": "string",
                "description": "Second-level timestamp refers to the specific start time. For example, 1602504000 means 2020/10/12 20:00:00 (UTC +8 time zone).; Note: This parameter cannot be specified at the same time as `date`",
                "example": "1602504000"
              },
              "timezone": {
                "type": "string",
                "description": "Time zone. Use IANA Time Zone Database standards such as Asia/Shanghai.; - The time zone is fixed to UTC +0 throughout the day;- The non-all-day time zone defaults to Asia/Shanghai",
                "example": "Asia/Shanghai"
              }
            }
          },
          "summary": {
            "type": "string",
            "description": "日程标题",
            "example": "日程标题"
          },
          "vchat": {
            "type": "object",
            "description": "Video conference information",
            "properties": {
              "description": {
                "type": "string",
                "description": "Third-party video conferencing text.; Default value: empty, in which case the default text is shown",
                "example": "Initiate a video conference"
              },
              "icon_type": {
                "type": "string",
                "description": "The icon type for third-party video conferencing.; Default value: default",
                "enum": [
                  "vc",
                  "live",
                  "default"
                ],
                "enumDescriptions": [
                  "Feishu Video Conference icon",
                  "Livestream video conference icon",
                  "Default icon"
                ],
                "example": "vc"
              },
              "live_link": {
                "type": "string",
                "description": "VC视频会议转直播URL，当vc_type=vc时有值",
                "example": "https://sample.feishu.cn/meeting/s/example"
              },
              "meeting_settings": {
                "type": "object",
                "description": "Pre-conference settings for video conference. The following conditions need to be met (all must be met):;- It takes effect when vc_type is vc.;- Requires edit permission for the event",
                "properties": {
                  "allow_attendees_start": {
                    "type": "boolean",
                    "description": "是否允许日程参与者发起会议。; 可选值有：;- true（默认值）：允许;- false：不允许; 注意：应用日历上操作日程时，该字段必须为 true，否则没有人能发起会议",
                    "example": true
                  },
                  "assign_hosts": {
                    "type": "array",
                    "description": "Specify the moderator by user ID, the ID type needs to be the same as user_id;_type remains consistent.; Notice:;- Only event organizers can designate hosts.;- Moderator cannot be a non-user.;- The host cannot be an external tenant user identity.;- When operating events on the app calendar, specifying a host is not allowed",
                    "items": {}
                  },
                  "auto_record": {
                    "type": "boolean",
                    "description": "是否开启自动录制。; 可选值有：;- true：开启;- false（默认值）：不开启",
                    "example": false
                  },
                  "join_meeting_permission": {
                    "type": "string",
                    "description": "设置入会范围",
                    "enum": [
                      "anyone_can_join",
                      "only_organization_employees",
                      "only_event_attendees"
                    ],
                    "enumDescriptions": [
                      "所有人可以加入会议",
                      "仅企业内用户可以加入会议",
                      "仅日程参与者可以加入会议"
                    ]
                  },
                  "open_lobby": {
                    "type": "boolean",
                    "description": "是否开启等候室。; 可选值有：;- true（默认值）：开启;- false：不开启",
                    "example": true
                  },
                  "owner_id": {
                    "type": "string",
                    "description": "Set the user ID of the conference owner, the ID type needs to be the same as user_id;_type remains consistent.; This parameter must meet all of the following conditions to take effect:;- Apply identity (tenant_access_token) request and operate event on the application calendar.;- The owner can only be set when the event is set to a VC meeting for the first time.;- owner cannot be a non-user identity.;- owner cannot be an external tenant user identity",
                    "example": "ou_7d8a6e6df7621556ce0d21922b676706ccs"
                  },
                  "password": {
                    "type": "string",
                    "description": "设置会议密码，仅支持 4-9 位数字",
                    "example": "123456"
                  }
                }
              },
              "meeting_url": {
                "type": "string",
                "description": "Video conferencing URL",
                "example": "https://example.com"
              },
              "third_party_meeting_settings": {
                "type": "object",
                "description": "三方会议设置",
                "properties": {
                  "meeting_descriptions": {
                    "type": "array",
                    "description": "多语言会议描述",
                    "items": {}
                  },
                  "meeting_id": {
                    "type": "string",
                    "description": "会议ID",
                    "example": "123"
                  },
                  "meeting_no": {
                    "type": "string",
                    "description": "会议号",
                    "example": "123"
                  },
                  "meeting_type": {
                    "type": "string",
                    "description": "三方会议类型",
                    "example": "julinker"
                  },
                  "password": {
                    "type": "string",
                    "description": "密码",
                    "example": "987"
                  }
                }
              },
              "vc_info": {
                "type": "object",
                "description": "VC视频会议原生信息",
                "required": [
                  "meeting_no",
                  "unique_id"
                ],
                "properties": {
                  "meeting_no": {
                    "type": "string",
                    "description": "会议号",
                    "example": "808056935"
                  },
                  "unique_id": {
                    "type": "string",
                    "description": "会议唯一ID",
                    "example": "7226647229510582291"
                  }
                }
              },
              "vc_type": {
                "type": "string",
                "description": "Video conferencing type. If video conferencing is not required, `no_meeting` must be passed",
                "enum": [
                  "vc",
                  "third_party",
                  "no_meeting",
                  "lark_live",
                  "unknown",
                  "third_party_meeting"
                ],
                "enumDescriptions": [
                  "Feishu video conferencing",
                  "Third-party linked video conferencing. When this type is selected, only the icon_type, description, and meeting_url fields in vchat will take effect.",
                  "No video conferencing. When this type is selected, other fields in vchat are invalid.",
                  "Feishu Live. This value is for client use, does not support calls via API, and is read-only.",
                  "Unknown type. This value is used for client compatibility, does not support API calls, and is read-only.",
                  "三方会议类型"
                ],
                "example": "third_party"
              }
            }
          },
          "visibility": {
            "type": "string",
            "description": "日程公开范围，新建日程默认为Default；仅新建日程时对所有参与人生效，之后修改该属性仅对当前身份生效",
            "enum": [
              "default",
              "public",
              "private"
            ],
            "enumDescriptions": [
              "默认权限，仅向他人显示是否“忙碌”",
              "公开，显示日程详情",
              "私密，仅自己可见"
            ]
          }
        }
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "event": {
        "type": "object",
        "description": "Newly created event entity",
        "required": [
          "end_time",
          "event_id",
          "start_time"
        ],
        "properties": {
          "app_link": {
            "type": "string",
            "description": "日程的app_link,跳转到具体的某个日程",
            "example": "https://sample.feishu.cn/calendar/event/example?calendarId=example_calendar&key=example_event"
          },
          "attachments": {
            "type": "array",
            "description": "日程附件",
            "items": {
              "type": "object",
              "properties": {
                "file_size": {
                  "type": "string",
                  "description": "附件大小",
                  "example": "2345"
                },
                "file_token": {
                  "type": "string",
                  "description": "附件 Token。调用“上传素材”接口，获取附件的 file_token。在调用上传素材接口时需要注意：; - `parent_type` 需传入固定值 `calendar`。;- `parent_node` 需传入与当前接口一致的日历 ID。; 附件校验规则：附件总大小不超过 25 MB",
                  "example": "xAAAAA"
                },
                "is_deleted": {
                  "type": "boolean",
                  "description": "是否删除附件",
                  "example": true
                },
                "name": {
                  "type": "string",
                  "description": "附件名称",
                  "example": "附件.jpeg"
                }
              }
            }
          },
          "attendee_ability": {
            "type": "string",
            "description": "参与人权限",
            "enum": [
              "none",
              "can_see_others",
              "can_invite_others",
              "can_modify_event"
            ],
            "enumDescriptions": [
              "无法编辑日程、无法邀请其它参与人、无法查看参与人列表",
              "无法编辑日程、无法邀请其它参与人、可以查看参与人列表",
              "无法编辑日程、可以邀请其它参与人、可以查看参与人列表",
              "可以编辑日程、可以邀请其它参与人、可以查看参与人列表"
            ]
          },
          "color": {
            "type": "integer",
            "description": "日程颜色，颜色RGB值的int32表示。仅对当前身份生效；客户端展示时会映射到色板上最接近的一种颜色；值为0或-1时默认跟随日历颜色",
            "example": 0
          },
          "create_time": {
            "type": "string",
            "description": "日程的创建时间戳",
            "example": "1675612800"
          },
          "description": {
            "type": "string",
            "description": "日程描述（纯文本）。读日程时同时返回 description 与 description_rich，本字段存放纯文本",
            "example": "日程描述"
          },
          "description_rich": {
            "type": "string",
            "description": "日程描述（Markdown 富文本）。读日程时保证有描述时此字段有值；仅有纯文本描述时会用该纯文本回填（此时与 description 值相同）",
            "example": "desc"
          },
          "end_time": {
            "type": "object",
            "description": "Event end time",
            "properties": {
              "date": {
                "type": "string",
                "description": "Specify the end time in days, in RFC 3339 format, for example, 2018-09-01.; Note: This parameter cannot be specified at the same time as `timestamp`",
                "example": "2018-09-01"
              },
              "timestamp": {
                "type": "string",
                "description": "Second-level timestamp refers to the specific end time. For example, 1602504000 means 2020/10/12 20:00:00 (UTC +8 time zone).; Note: This parameter cannot be specified at the same time as `date`",
                "example": "1602504000"
              },
              "timezone": {
                "type": "string",
                "description": "Time zone. Use IANA Time Zone Database standards such as Asia/Shanghai.; - The time zone is fixed to UTC +0 throughout the day;- The non-all-day time zone defaults to Asia/Shanghai",
                "example": "Asia/Shanghai"
              }
            }
          },
          "event_check_in": {
            "type": "object",
            "description": "日程签到设置，为空则不进行日程签到设置",
            "required": [
              "enable_check_in"
            ],
            "properties": {
              "check_in_end_time": {
                "type": "object",
                "description": "Event check-in end time"
              },
              "check_in_start_time": {
                "type": "object",
                "description": "Event check-in start time.; Note: The check-in start time cannot be greater than or equal to the check-in end time"
              },
              "enable_check_in": {
                "type": "boolean",
                "description": "是否启用日程签到",
                "example": true
              },
              "need_notify_attendees": {
                "type": "boolean",
                "description": "签到开始时是否自动发送签到通知给参与者"
              }
            }
          },
          "event_id": {
            "type": "string",
            "description": "日程ID",
            "example": "75d28f9b-e35c-4230-8a83-4a661497db54_0"
          },
          "event_organizer": {
            "type": "object",
            "description": "日程组织者信息",
            "properties": {
              "display_name": {
                "type": "string",
                "description": "日程组织者姓名",
                "example": "孙二二"
              },
              "user_id": {
                "type": "string",
                "description": "日程组织者user ID",
                "example": "ou_xxxxxx"
              }
            }
          },
          "free_busy_status": {
            "type": "string",
            "description": "日程占用的忙闲状态，新建日程默认为Busy；仅新建日程时对所有参与人生效，之后修改该属性仅对当前身份生效",
            "enum": [
              "busy",
              "free"
            ],
            "enumDescriptions": [
              "忙碌",
              "空闲"
            ]
          },
          "is_exception": {
            "type": "boolean",
            "description": "日程是否是一个重复日程的例外日程",
            "example": false
          },
          "location": {
            "type": "object",
            "description": "日程地点",
            "properties": {
              "address": {
                "type": "string",
                "description": "地点地址",
                "example": "普通市和平区世纪大道1号"
              },
              "latitude": {
                "type": "number",
                "description": "地点坐标纬度信息，对于国内的地点，采用GCJ-02标准，海外地点采用WGS84标准",
                "example": 31.239702224731445
              },
              "longitude": {
                "type": "number",
                "description": "地点坐标经度信息，对于国内的地点，采用GCJ-02标准，海外地点采用WGS84标准",
                "example": 121.49971771240234
              },
              "name": {
                "type": "string",
                "description": "地点名称",
                "example": "东方明珠"
              }
            }
          },
          "organizer_calendar_id": {
            "type": "string",
            "description": "日程组织者日历ID",
            "example": "feishu.cn_example0000@group.calendar.feishu.cn"
          },
          "recurrence": {
            "type": "string",
            "description": "重复日程的重复性规则",
            "example": "FREQ=DAILY;INTERVAL=1"
          },
          "recurring_event_id": {
            "type": "string",
            "description": "例外日程的原重复日程的event_id",
            "example": "75d28f9b-e35c-4230-8a83-4a661497db54_0"
          },
          "reminders": {
            "type": "array",
            "description": "日程提醒列表",
            "items": {
              "type": "object",
              "properties": {
                "minutes": {
                  "type": "integer",
                  "description": "日程提醒时间的偏移量，正数时表示在日程开始前X分钟提醒，负数时表示在日程开始后X分钟提醒;新建或更新日程时传入该字段，仅对当前身份生效",
                  "example": 5,
                  "minimum": -20160,
                  "maximum": 20160
                }
              }
            }
          },
          "schemas": {
            "type": "array",
            "description": "日程自定义信息",
            "items": {
              "type": "object",
              "properties": {
                "app_link": {
                  "type": "string",
                  "description": "按钮点击后跳转的链接",
                  "example": "xxxx"
                },
                "ui_name": {
                  "type": "string",
                  "description": "UI 项名称",
                  "example": "xxx"
                },
                "ui_status": {
                  "type": "string",
                  "description": "UI项自定义状态",
                  "enum": [
                    "hide",
                    "readonly",
                    "editable",
                    "unknown"
                  ],
                  "enumDescriptions": [
                    "隐藏显示",
                    "只读",
                    "可编辑",
                    "未知UI项自定义状态，仅用于读取时兼容"
                  ]
                }
              }
            }
          },
          "self_rsvp_status": {
            "type": "string",
            "description": "当前日历的RSVP状态",
            "enum": [
              "needs_action",
              "accept",
              "tentative",
              "decline",
              "removed"
            ],
            "enumDescriptions": [
              "参与人尚未回复状态，或表示会议室预约中",
              "参与人回复接受，或表示会议室预约成功",
              "参与人回复待定",
              "参与人回复拒绝，或表示会议室预约失败",
              "参与人或会议室已经从日程中被移除"
            ]
          },
          "source": {
            "type": "string",
            "description": "日程source",
            "example": "source"
          },
          "start_time": {
            "type": "object",
            "description": "Event start time",
            "properties": {
              "date": {
                "type": "string",
                "description": "Specify the start time in days, in RFC 3339 format, for example, 2018-09-01.; Note: This parameter cannot be specified at the same time as `timestamp`",
                "example": "2018-09-01"
              },
              "timestamp": {
                "type": "string",
                "description": "Second-level timestamp refers to the specific start time. For example, 1602504000 means 2020/10/12 20:00:00 (UTC +8 time zone).; Note: This parameter cannot be specified at the same time as `date`",
                "example": "1602504000"
              },
              "timezone": {
                "type": "string",
                "description": "Time zone. Use IANA Time Zone Database standards such as Asia/Shanghai.; - The time zone is fixed to UTC +0 throughout the day;- The non-all-day time zone defaults to Asia/Shanghai",
                "example": "Asia/Shanghai"
              }
            }
          },
          "status": {
            "type": "string",
            "description": "日程状态",
            "enum": [
              "tentative",
              "confirmed",
              "cancelled"
            ],
            "enumDescriptions": [
              "未回应",
              "已确认",
              "日程已取消"
            ]
          },
          "summary": {
            "type": "string",
            "description": "日程标题",
            "example": "日程标题"
          },
          "vchat": {
            "type": "object",
            "description": "Video conference information",
            "properties": {
              "description": {
                "type": "string",
                "description": "Third-party video conferencing copywriting.; Default value: empty, indicating that the field will not be updated",
                "example": "Initiate a video conference"
              },
              "icon_type": {
                "type": "string",
                "description": "The icon type for third-party video conferencing.; Default value: empty, indicating that the field will not be updated",
                "enum": [
                  "vc",
                  "live",
                  "default"
                ],
                "enumDescriptions": [
                  "Feishu Video Conference icon",
                  "Livestream video conference icon",
                  "Default icon"
                ],
                "example": "vc"
              },
              "live_link": {
                "type": "string",
                "description": "VC视频会议转直播URL，当vc_type=vc时有值",
                "example": "https://sample.feishu.cn/meeting/s/example"
              },
              "meeting_settings": {
                "type": "object",
                "description": "Pre-meeting settings for Feishu Video Conferencing (VC)"
              },
              "meeting_url": {
                "type": "string",
                "description": "Video conferencing URL.; Default value: empty, indicating that the field will not be updated",
                "example": "https://example.com"
              },
              "third_party_meeting_settings": {
                "type": "object",
                "description": "三方会议设置"
              },
              "vc_info": {
                "type": "object",
                "description": "VC视频会议原生信息"
              },
              "vc_type": {
                "type": "string",
                "description": "Video conferencing type. If video conferencing is not required, `no_meeting` must be passed",
                "enum": [
                  "vc",
                  "third_party",
                  "no_meeting",
                  "lark_live",
                  "unknown",
                  "third_party_meeting"
                ],
                "enumDescriptions": [
                  "Feishu video conferencing. When this type is selected, other fields in vchat are invalid.",
                  "Third-party linked video conferencing. When this type is selected, only the icon_type, description, and meeting_url fields in vchat will take effect.",
                  "No video conferencing. When this type is selected, other fields in vchat are invalid.",
                  "Feishu Live. This value is for client use, does not support calls via API, and is read-only.",
                  "Unknown type. This value is used for client compatibility, does not support API calls, and is read-only.",
                  "三方会议类型"
                ],
                "example": "third_party"
              }
            }
          },
          "visibility": {
            "type": "string",
            "description": "日程公开范围，新建日程默认为Default；仅新建日程时对所有参与人生效，之后修改该属性仅对当前身份生效",
            "enum": [
              "default",
              "public",
              "private"
            ],
            "enumDescriptions": [
              "默认权限，仅向他人显示是否“忙碌”",
              "公开，显示日程详情",
              "私密，仅自己可见"
            ]
          }
        }
      }
    }
  },
