/** Explicit live acceptance: saved default models, real browser capture and vendor calls. */
import assert from 'node:assert/strict';
import { execFileSync } from 'node:child_process';
import { mkdtemp, readFile, writeFile } from 'node:fs/promises';
import { homedir, tmpdir } from 'node:os';
import { join } from 'node:path';
import playwright from 'playwright-core';
const { chromium } = playwright;

const config = JSON.parse(await readFile(join(homedir(), '.xopc/xopc.json'), 'utf8'));
const base = `http://127.0.0.1:${config.gateway.port}`;
const web = process.env.XOPC_WEB_E2E_URL ?? 'http://localhost:3000/';
const directory = await mkdtemp(join(tmpdir(), 'xopc-model-consolidation-'));
const headers = { Authorization: `Bearer ${config.gateway.auth.token}` };
const request = async (path: string) => {
  const response = await fetch(base + path, { headers, signal: AbortSignal.timeout(15_000) });
  assert.equal(response.status, 200);
  const data = await response.json(); return data.payload ?? data;
};
const before = await request('/api/global-defaults');
const status = await request('/api/status');
assert.deepEqual(status.voice.dictation, { mode: 'recorded', provider: 'qwen-token-plan-cn' });
assert.equal(before.defaults.models.background.primary, 'xopc-cloud/auto');
assert.equal(config.messages.tts.provider, 'qwen-token-plan-cn');
const report: Record<string, any> = { startedAt: new Date().toISOString(), directory, realGateway: true, realVendorRequests: true, syntheticMicrophone: true, checks: [], errors: [], passed: false };
const checks = report.checks;
console.log(JSON.stringify({ directory }));
const tts = await fetch(base + '/api/voice/speech', { method: 'POST', headers: { ...headers, 'Content-Type': 'application/json' }, body: JSON.stringify({ text: '这是百炼订阅测试。测试成功。验证数字四七二九。', language: 'zh' }), signal: AbortSignal.timeout(90_000) });
assert.ok(tts.ok, `Default TTS HTTP ${tts.status}`);
await writeFile(join(directory, 'speech.mp3'), Buffer.from(await tts.arrayBuffer()));
execFileSync(process.env.XOPC_FFMPEG_PATH ?? '/opt/homebrew/bin/ffmpeg', ['-v', 'error', '-y', '-i', join(directory, 'speech.mp3'), '-ar', '48000', '-ac', '1', '-c:a', 'pcm_s16le', join(directory, 'microphone.wav')]);
checks.push({ name: 'default-tts', passed: true, provider: 'qwen-token-plan-cn' });
const browser = await chromium.launch({ channel: 'chrome', headless: true, args: ['--use-fake-device-for-media-stream', '--use-fake-ui-for-media-stream', `--use-file-for-fake-audio-capture=${join(directory, 'microphone.wav')}`, '--autoplay-policy=no-user-gesture-required'] });
const context = await browser.newContext({ permissions: ['microphone'], viewport: { width: 1440, height: 1000 } });
const page = await context.newPage();
page.setDefaultTimeout(20_000);
page.on('pageerror', error => report.errors.push(error.message));
let conversationId: string | undefined;
try {
  await page.addInitScript(() => localStorage.setItem('xopc.language', 'zh'));
  await page.goto(web + '#/settings/agent-defaults');
  await page.getByLabel('网关访问凭据', { exact: true }).fill(config.gateway.auth.token);
  await page.getByRole('button', { name: '连接', exact: true }).click();
  await page.getByRole('heading', { name: '共用模型', exact: true }).waitFor();
  const summary = page.locator('section').filter({ has: page.getByRole('heading', { name: '共用模型', exact: true }) });
  assert.equal(await summary.locator('input, [role="combobox"]').count(), 0);
  await page.screenshot({ path: join(directory, 'agent-defaults-summary.png') });
  await summary.getByRole('link').filter({ hasText: '对话与任务' }).click();
  await page.getByRole('heading', { name: '对话与任务', exact: true }).waitFor();
  await page.getByText('任务模型路由', { exact: true }).waitFor();
  await page.screenshot({ path: join(directory, 'chat-capability.png') });
  checks.push({ name: 'single-model-settings-entry', passed: true, summaryLinksToCapability: true, advancedTaskRoutesRetained: true });
  await page.goto(web + '#/settings/capabilities/models?use=transcription');
  await page.getByRole('heading', { name: '录音与听写', exact: true }).waitFor();
  await page.getByText(/听写默认复用录音识别模型/).waitFor();
  await page.screenshot({ path: join(directory, 'transcription-capability.png') });
  checks.push({ name: 'shared-transcription-settings', passed: true });
  await page.goto(web + '#/chat/new');
  await page.getByRole('button', { name: /^听写/ }).waitFor();
  await page.getByRole('button', { name: /^听写/ }).click();
  await page.getByText('正在录音，点击完成后转为文字', { exact: true }).waitFor();
  await page.waitForTimeout(9000);
  const transcribed = page.waitForResponse(response => new URL(response.url()).pathname === '/api/voice/transcriptions');
  await page.getByRole('button', { name: '完成', exact: true }).click();
  const response = await transcribed;
  assert.equal(response.status(), 200);
  const result = (await response.json()).payload;
  assert.equal(result.provider, 'qwen-token-plan-cn');
  assert.match(result.text, /4729|四七二九/);
  const editor = page.locator('[contenteditable="true"]').first();
  await page.waitForFunction(() => document.querySelector('[contenteditable="true"]')?.textContent?.includes('测试成功'), undefined, { timeout: 90_000 });
  await page.screenshot({ path: join(directory, 'dictation-filled.png') });
  checks.push({ name: 'page-dictation', passed: true, provider: result.provider, transcript: result.text, editorText: await editor.innerText(), route: status.voice.dictation });
  await page.goto(web + '#/notes');
  await page.getByRole('button', { name: '开始录音', exact: true }).waitFor();
  const created = page.waitForResponse(response => new URL(response.url()).pathname === '/api/discussions' && response.request().method() === 'POST');
  void created.catch(() => {});
  await page.getByRole('button', { name: '开始录音', exact: true }).click();
  const consent = page.getByRole('button', { name: '确认并开始', exact: true });
  await consent.or(page.getByRole('button', { name: '标重点', exact: true })).first().waitFor();
  if (await consent.isVisible()) await consent.click();
  const capture = (await (await created).json()).discussion;
  await page.getByRole('button', { name: '标重点', exact: true }).waitFor();
  await page.waitForTimeout(9000);
  await page.getByRole('button', { name: '完成', exact: true }).click();
  await page.getByText('原音已同步，可以离开当前页面。', { exact: true }).waitFor({ timeout: 60_000 });
  await page.screenshot({ path: join(directory, 'recording-saved.png') });
  let note: any;
  const recordingDeadline = Date.now() + 180_000;
  while (Date.now() < recordingDeadline) {
    note = await request(`/api/discussions/${capture.id}`);
    if (note.discussion.status === 'completed') break;
    if (note.discussion.status === 'needs_attention') throw new Error(note.discussion.failureMessage);
    await page.waitForTimeout(1000);
  }
  assert.equal(note.discussion.status, 'completed');
  assert.match(note.discussion.canonicalTranscript, /4729|四七二九/);
  assert.ok(note.discussion.audioAttachmentId);
  const dismissRecording = page.getByRole('button', { name: '稍后查看', exact: true });
  if (await dismissRecording.isVisible()) await dismissRecording.click();
  await page.goto(web + `#/notes/${capture.noteId}`);
  await page.locator('audio').waitFor();
  await page.locator('audio').evaluate((audio: HTMLAudioElement) => audio.play());
  await page.waitForFunction(() => document.querySelector('audio')!.currentTime > 0.1);
  await page.locator('audio').evaluate((audio: HTMLAudioElement) => audio.pause());
  await page.getByRole('button', { name: '原文', exact: true }).click();
  await page.getByText(/这是百炼订阅测试/).first().waitFor();
  await page.screenshot({ path: join(directory, 'recorded-note.png') });
  checks.push({ name: 'page-recording', passed: true, discussionId: capture.id, noteId: capture.noteId, transcript: note.discussion.canonicalTranscript, originalAudioPlayback: true, completed: true });
  await page.goto(web + '#/chat/new');
  await editor.waitFor();
  await editor.fill('这是百炼真实生图验收。请使用 image_generate 画一只可爱的小猫在跳舞，比例1:1，只生成一张。使用默认图片模型，不切换服务，不保存记忆。');
  const submitted = page.waitForResponse(response => /\/api\/sessions\/[^/]+\/inputs$/.test(new URL(response.url()).pathname) && response.request().method() === 'POST');
  await page.getByRole('button', { name: '发送', exact: true }).click();
  const input = await submitted;
  assert.equal(input.status(), 202);
  conversationId = new URL(input.url()).pathname.split('/')[3];
  const deadline = Date.now() + 240_000;
  let success: any;
  while (Date.now() < deadline) {
    await page.waitForTimeout(1000);
    const history = await request(`/api/sessions/${conversationId}?include=transcriptRows`);
    const rows = history.session?.transcriptRows ?? [];
    const error = rows.findLast((row: any) => row.role === 'assistant' && row.errorMessage);
    if (error) throw new Error(error.errorMessage);
    success = rows.find((row: any) => row.role === 'toolResult' && row.toolName === 'image_generate' && row.details?.media?.length);
    if (success) break;
    const failure = rows.find((row: any) => row.role === 'toolResult' && row.toolName === 'image_generate' && row.isError);
    if (failure) throw new Error(JSON.stringify(failure.content));
  }
  assert.ok(success, 'No generated image');
  assert.equal(success.details.provider, 'qwen-token-plan-cn');
  const media = success.details.media[0];
  const image = await fetch(`${base}/api/media/read?uri=${encodeURIComponent(media.uri)}&conversationId=${conversationId}`, { headers, signal: AbortSignal.timeout(20_000) });
  assert.ok(image.ok);
  await writeFile(join(directory, 'dancing-cat.png'), Buffer.from(await image.arrayBuffer()));
  await page.waitForFunction(() => Array.from(document.images).some(image => image.naturalWidth > 256), undefined, { timeout: 120_000 });
  await page.screenshot({ path: join(directory, 'chat-image.png') });
  checks.push({ name: 'page-chat-image', passed: true, provider: success.details.provider, model: success.details.model, attachmentRead: true, rendered: true, attempts: success.details.attempts });
  assert.deepEqual((await request('/api/global-defaults')).defaults, before.defaults);
  assert.equal(report.errors.length, 0);
  report.passed = true;
} catch (error) {
  report.error = String(error).replace(/sk-[\w.-]+/g, '[redacted]').replaceAll(config.gateway.auth.token, '[redacted]');
  await page.screenshot({ path: join(directory, 'failure.png') }).catch(() => {});
  process.exitCode = 1;
} finally {
  if (conversationId) await fetch(`${base}/api/sessions/${conversationId}`, { method: 'DELETE', headers, signal: AbortSignal.timeout(10_000) }).catch(() => {});
  await browser.close();
  report.finishedAt = new Date().toISOString();
  await writeFile(join(directory, 'report.json'), JSON.stringify(report, null, 2));
  console.log(JSON.stringify(report));
}
