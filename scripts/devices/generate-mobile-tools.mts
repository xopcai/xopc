import { createHash } from 'node:crypto';
import { readFileSync, writeFileSync } from 'node:fs';
import { canonicalJson, deviceStateDescriptor, locationDescriptor, personalDescriptor, PERSONAL_TOOL_NAMES, providerEndpointDescriptor, providerToolName, providerCatalogSchema } from '../../packages/endpoint-tools-protocol/src/index.js';

const descriptors = ['state', 'power'].map(capability => deviceStateDescriptor('mobile', capability as 'state' | 'power'));
const stateCatalog = canonicalJson(descriptors);
descriptors.push(locationDescriptor('mobile'));
const catalog = canonicalJson(descriptors);
descriptors.push(...PERSONAL_TOOL_NAMES.map(personalDescriptor));
const personalCatalog = canonicalJson(descriptors);
const revisions = descriptors.map(descriptor => createHash('sha256').update(canonicalJson(descriptor)).digest('hex'));
const appTool = {
  name: 'check_interactive', title: 'Check app interactive readiness',
  description: 'Check whether the selected xopc mobile app is currently active for interactive device work.',
  inputSchema: { type: 'object', additionalProperties: false },
  outputSchema: { type: 'object', properties: { active: { const: true } }, required: ['active'], additionalProperties: false },
  effect: 'read', sensitivity: 'public', confirmation: 'never', requiresForeground: true,
  requiredPermissions: [], timeoutMs: 5_000, maxConcurrency: 1, supportsCancellation: false, idempotent: true, resultKinds: ['json'],
} as const;
const localId = 'mobile_app';
const appProvider = providerCatalogSchema.parse({ revision: 1, providers: [{
  localId, title: 'Mobile app readiness', summary: 'Check whether the selected mobile app is ready for interaction.',
  tools: [appTool],
}] });
const appCatalog = canonicalJson(appProvider);
const appName = providerToolName(localId, appTool.name);
const appRevision = createHash('sha256').update(canonicalJson(providerEndpointDescriptor(localId, appProvider.providers[0].tools[0]))).digest('hex');
const outputs: Record<string, string> = {
  'apps/mobile-android/app/src/main/java/ai/xopc/mobile/gateway/DeviceToolCatalog.kt': `// Generated by scripts/devices/generate-mobile-tools.mts.\npackage ai.xopc.mobile.gateway\n\ninternal object DeviceToolCatalog {\n  const val stateJson = """${stateCatalog}"""\n  const val personalJson = """${personalCatalog}"""\n  const val json = """${catalog}"""\n  const val appProviderJson = """${appCatalog}"""\n  const val appProviderId = "${localId}"\n  const val appToolName = "${appName}"\n  const val appToolRevision = "${appRevision}"\n  val revisions = listOf(${revisions.map(value => JSON.stringify(value)).join(', ')})\n}\n`,
  'apps/mobile-harmony/entry/src/main/ets/common/deviceToolCatalog.ets': `// Generated by scripts/devices/generate-mobile-tools.mts.\nexport const DEVICE_STATE_TOOL_CATALOG_JSON: string = ${JSON.stringify(stateCatalog)};\nexport const DEVICE_TOOL_CATALOG_JSON: string = ${JSON.stringify(catalog)};\nexport const DEVICE_PERSONAL_TOOL_CATALOG_JSON: string = ${JSON.stringify(personalCatalog)};\nexport const APP_PROVIDER_JSON: string = ${JSON.stringify(appCatalog)};\nexport const APP_PROVIDER_ID: string = "${localId}";\nexport const APP_TOOL_NAME: string = "${appName}";\nexport const APP_TOOL_REVISION: string = "${appRevision}";\nexport const DEVICE_TOOL_REVISIONS: string[] = ${JSON.stringify(revisions)};\n`,
  'apps/mobile-ios/XopcMobile/Core/Networking/DeviceToolCatalog.swift': `// Generated by scripts/devices/generate-mobile-tools.mts.\nimport Foundation\n\nenum DeviceToolCatalog {\n    // swiftlint:disable:next line_length\n    static let stateJson = #"${stateCatalog}"#\n    // swiftlint:disable:next line_length\n    static let personalJson = #"${personalCatalog}"#\n    // swiftlint:disable:next line_length\n    static let json = #"${catalog}"#\n    // swiftlint:disable:next line_length\n    static let appProviderJson = #"${appCatalog}"#\n    static let appProviderId = "${localId}"\n    static let appToolName = "${appName}"\n    static let appToolRevision = "${appRevision}"\n    // swiftlint:disable:next line_length\n    static let revisions = [${revisions.map(value => JSON.stringify(value)).join(', ')}]\n}\n`,
};
for (const [path, content] of Object.entries(outputs)) {
  if (process.argv.includes('--check')) {
    if (readFileSync(path, 'utf8') !== content) throw new Error(`Stale generated device catalog: ${path}`);
  } else writeFileSync(path, content);
}
