/** Live UI acceptance for same-page configuration; credentials never leave the local gateway. */
import assert from 'node:assert/strict';
import { mkdtemp, readFile, writeFile } from 'node:fs/promises';
import { homedir, tmpdir } from 'node:os';
import { join } from 'node:path';
import playwright from 'playwright-core';

const config = JSON.parse(await readFile(join(homedir(), '.xopc/xopc.json'), 'utf8'));
const base = `http://127.0.0.1:${config.gateway.port}`;
const web = process.env.XOPC_WEB_E2E_URL ?? 'http://127.0.0.1:3000/';
const headers = { Authorization: `Bearer ${config.gateway.auth.token}`, 'Content-Type': 'application/json' };
const directory = await mkdtemp(join(tmpdir(), 'xopc-model-inline-'));
const request = async (path: string, method = 'GET', body?: unknown) => {
  const response = await fetch(base + path, { method, headers, ...(body ? { body: JSON.stringify(body) } : {}), signal: AbortSignal.timeout(15_000) });
  const data = await response.json(); assert.ok(response.ok, `${path}: HTTP ${response.status}`); return data.payload ?? data;
};
const before = await request('/api/global-defaults');
const savedConfigBefore = (await request('/api/config')).config;
const voiceBefore = savedConfigBefore.tts;
const originalVoice = voiceBefore.providers?.['qwen-token-plan-cn']?.voice;
const report = { directory, passed: false, realGateway: true, realVendorRequests: false, checks: [] as string[], errors: [] as string[], error: '' };
const browser = await playwright.chromium.launch({ channel: 'chrome', headless: true });
const page = await browser.newPage({ viewport: { width: 1440, height: 1000 }, reducedMotion: 'reduce' });
page.setDefaultTimeout(20_000);
page.on('pageerror', error => report.errors.push(error.message));
page.on('response', response => { if (response.status() >= 400) console.error(JSON.stringify({ status: response.status(), path: new URL(response.url()).pathname })); });
const waitConfig = async (predicate: (config: any) => boolean) => {
  for (let i = 0; i < 40; i++) { const config = (await request('/api/config')).config; if (predicate(config)) return; await page.waitForTimeout(250); }
  throw new Error('Configuration save did not complete');
};
try {
  await page.addInitScript(() => localStorage.setItem('xopc.language', 'zh'));
  await page.route('**/api/**', route => {
    const url = new URL(route.request().url());
    return route.continue({ headers: url.origin === new URL(web).origin ? { ...route.request().headers(), Authorization: headers.Authorization } : route.request().headers() });
  });
  await page.goto(web + '#/settings/capabilities/models');
  await page.getByRole('heading', { name: '能力总览', exact: true }).waitFor();
  assert.equal(await page.getByRole('link', { name: /^配置 / }).count(), 0);
  assert.equal(await page.getByRole('button', { name: /^选择 / }).count(), 7);
  const origin = page.url();
  const speech = page.locator('[data-capability="speech"]');
  await speech.getByRole('button', { name: '设置', exact: true }).click();
  const readout = page.getByRole('dialog').first().getByRole('button', { name: '消息自动朗读', exact: true });
  await page.getByRole('dialog').first().screenshot({ path: join(directory, 'speech-settings-modal.png') });
  await readout.click();
  const patched = page.waitForResponse(response => new URL(response.url()).pathname === '/api/config' && response.request().method() === 'PATCH');
  await page.getByRole('button', { name: '标签（[[tts]]）', exact: true }).click();
  await page.getByRole('dialog').first().getByRole('heading').first().click();
  assert.ok((await patched).ok());
  await waitConfig(value => value.tts.trigger === 'tagged');
  await request('/api/config', 'PATCH', { tts: { enabled: voiceBefore.enabled, trigger: voiceBefore.trigger } });
  await page.waitForTimeout(500);
  report.checks.push('Speech readout parameter saved inline and restored; no route change');
  assert.equal(page.url(), origin);
  await page.getByRole('dialog').first().getByRole('button', { name: '完成', exact: true }).click();
  const transcription = page.locator('[data-capability="transcription"]');
  await transcription.getByRole('button', { name: '管理服务', exact: true }).click();
  const transcriptionDialog = page.getByRole('dialog').first();
  await transcriptionDialog.screenshot({ path: join(directory, 'transcription-services-modal.png') });
  await transcriptionDialog.getByRole('button', { name: /Bailian.*[Ss]ubscription/ }).click();
  await transcriptionDialog.getByRole('heading', { name: '连接服务 · 录音识别', exact: true }).waitFor();
  const connectionDraft = transcriptionDialog.locator('#provider-setup-key');
  await connectionDraft.fill('fixture-unsaved-not-a-key');
  await transcriptionDialog.getByRole('button', { name: '完成', exact: true }).click();
  await transcription.getByRole('button', { name: '管理服务', exact: true }).click();
  assert.equal(await connectionDraft.inputValue(), 'fixture-unsaved-not-a-key');
  await connectionDraft.fill('');
  report.checks.push('Service draft survives closing and reopening the modal without saving a key');
  assert.equal(await transcriptionDialog.getByText('对话与任务', { exact: true }).count(), 0);
  assert.equal(await page.getByRole('dialog').count(), 1, 'Connecting must not stack a new modal over settings');
  await transcriptionDialog.getByRole('button', { name: '连接并用于录音识别', exact: true }).click();
  await transcriptionDialog.getByRole('heading', { name: '连接服务 · 录音识别', exact: true }).waitFor({ state: 'hidden' });
  assert.equal(page.url(), origin);
  report.checks.push('Saved Bailian credential reused and applied only to transcription within the same modal');
  const languageBefore = savedConfigBefore.voice;
  const languageMode = languageBefore.languageMode ?? 'auto';
  const languageSelector = transcriptionDialog.getByRole('button', { name: /^(跟随应用语言|保留手动设置)$/ });
  await languageSelector.click();
  await page.getByRole('button', { name: languageMode === 'auto' ? '保留手动设置' : '跟随应用语言', exact: true }).last().click();
  await waitConfig(value => value.voice.languageMode !== languageMode);
  await languageSelector.click();
  await page.getByRole('button', { name: languageMode === 'auto' ? '跟随应用语言' : '保留手动设置', exact: true }).last().click();
  await waitConfig(value => value.voice.languageMode === languageMode);
  await request('/api/config', 'PATCH', { voicePatchMode: 'merge', voice: { languageMode, language: languageBefore.language } });
  report.checks.push('Recognition language saves twice with acknowledged revisions and preserves the model');
  await transcriptionDialog.getByRole('button', { name: '完成', exact: true }).click();
  const plan = await request('/api/models/setup/qwen-token-plan-cn');
  const vision = plan.uses.find((use: any) => use.id === 'vision');
  const different = vision.choices.find((choice: any) => choice.id !== vision.current);
  assert.ok(different, 'Expected a second eligible vision model');
  await page.getByRole('button', { name: '选择 看图', exact: true }).click();
  await page.getByRole('searchbox').fill(`${different.name} ${plan.profile.name}`);
  await page.getByRole('button', { name: different.name, exact: true }).click();
  for (let i = 0; i < 40; i++) { if ((await request('/api/global-defaults')).defaults.models.imageUnderstanding.primary === different.id) break; await page.waitForTimeout(250); }
  const switched = (await request('/api/global-defaults')).defaults;
  assert.equal(switched.models.imageUnderstanding.primary, different.id);
  assert.deepEqual(switched.models.background, before.defaults.models.background);
  assert.deepEqual(switched.models.chat, before.defaults.models.chat);
  await request('/api/global-defaults', 'PATCH', { defaults: before.defaults, scope: 'models', expectedModels: switched.models });
  report.checks.push('Direct model switching changes vision only and leaves background and chat routes unchanged; original settings restored');
  await page.screenshot({ path: join(directory, 'capabilities-inline.png'), fullPage: true });
  const revisionConfig = (await request('/api/config')).config;
  const revision = revisionConfig.voiceSettingsRevisions?.speech;
  assert.ok(revision, 'Gateway must expose scoped voice revisions');
  await request('/api/config', 'PATCH', { expectedVoiceRevision: { capability: 'speech', revision }, tts: { trigger: 'tagged' } });
  const stale = await fetch(base + '/api/config', { method: 'PATCH', headers, body: JSON.stringify({ expectedVoiceRevision: { capability: 'speech', revision }, tts: { provider: 'xopc-cloud' } }) });
  assert.equal(stale.status, 409);
  assert.equal((await request('/api/config')).config.tts.provider, 'qwen-token-plan-cn');
  await request('/api/config', 'PATCH', { tts: { enabled: voiceBefore.enabled, trigger: voiceBefore.trigger } });
  report.checks.push('Authenticated stale voice write returns 409 before changing the model; legacy unguarded save remains supported');
  await page.goto(web + '#/settings/capabilities/models?use=speech');
  await page.getByRole('button', { name: '连接或管理服务', exact: true }).first().click();
  assert.equal(await page.getByRole('button', { name: '消息自动朗读', exact: true }).count(), 1);
  report.checks.push('Legacy detail connection mounts one speech editor');
  await page.goto(web + '#/chat/new');
  const draft = page.locator('[contenteditable="true"]').first();
  await draft.fill('保留这段未发送的草稿');
  const chatOrigin = page.url();
  const draftNode = await draft.elementHandle();
  await page.evaluate(() => window.dispatchEvent(new CustomEvent('open-capability-settings', { detail: { use: 'speech' } })));
  const sheet = page.getByRole('dialog').first();
  await sheet.getByRole('heading', { name: '文字转语音', exact: true }).waitFor();
  await sheet.getByRole('button', { name: '消息自动朗读', exact: true }).click();
  const failedSave = page.waitForResponse(response => new URL(response.url()).pathname === '/api/config' && response.request().method() === 'PATCH' && response.status() === 409);
  await page.getByRole('button', { name: '始终', exact: true }).click();
  await request('/api/config', 'PATCH', { tts: { trigger: 'inbound' } });
  await failedSave;
  await sheet.getByRole('button', { name: '重新加载（放弃未保存更改）', exact: true }).click();
  await sheet.getByRole('button', { name: '完成', exact: true }).waitFor();
  for(let i=0; await sheet.getByRole('button', { name: '完成', exact: true }).isDisabled() && i<40; i++) await page.waitForTimeout(100);
  assert.ok(await sheet.getByRole('button', { name: '完成', exact: true }).isEnabled());
  assert.equal(await sheet.getByRole('alert').count(), 0);
  await request('/api/config', 'PATCH', { tts: { enabled: voiceBefore.enabled, trigger: voiceBefore.trigger } });
  report.checks.push('Stale voice save preserves its draft; inline reload recovers without leaving chat');
  await sheet.getByRole('button', { name: '选择 文字转语音', exact: true }).click();
  await page.getByRole('searchbox').last().fill('qwen');
  assert.ok(await sheet.getByRole('button', { name: /Qwen Audio/ }).count());
  await page.keyboard.press('Escape');
  await sheet.getByRole('button', { name: '完成', exact: true }).click();
  assert.equal(page.url(), chatOrigin); assert.equal(await draft.innerText(), '保留这段未发送的草稿');
  assert.ok(await draftNode!.evaluate(node => node.isConnected));
  report.checks.push('Context settings sheet preserves chat route, draft, focusable model picker and modal stacking');
  await page.evaluate(() => window.dispatchEvent(new CustomEvent('open-capability-settings', { detail: { use: 'image' } })));
  const imageSheet = page.getByRole('dialog').first();
  await imageSheet.getByRole('button', { name: '管理服务', exact: true }).first().click();
  await imageSheet.getByRole('button', { name: '添加图片服务', exact: true }).click();
  const nestedImage = imageSheet.locator('[role="dialog"]');
  await nestedImage.getByRole('heading', { name: '添加图片服务', exact: true }).waitFor();
  assert.ok(await nestedImage.isVisible());
  await nestedImage.getByRole('button', { name: '取消', exact: true }).last().click();
  await imageSheet.getByRole('button', { name: '完成', exact: true }).click();
  assert.equal(page.url(), chatOrigin);
  assert.equal(await draft.innerText(), '保留这段未发送的草稿');
  report.checks.push('Custom image connection dialog stays visible inside the settings sheet and closes back to the draft');
  await page.goto(web + '#/settings/capabilities/voice');
  await page.getByRole('heading', { name: '能力总览', exact: true }).waitFor();
  assert.equal(await page.getByRole('button', { name: /^选择 / }).count(), 3);
  await page.locator('[data-capability="speech"]').getByRole('button', { name: '设置', exact: true }).click();
  const voiceDialog = page.getByRole('dialog').first();
  await voiceDialog.getByRole('button', { name: '消息自动朗读', exact: true }).waitFor();
  await page.setViewportSize({ width: 390, height: 844 });
  await page.evaluate(() => document.documentElement.classList.add('dark'));
  assert.ok(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth));
  await page.screenshot({ path: join(directory, 'voice-mobile-dark.png'), fullPage: true });
  report.checks.push('Voice entry retains three inline capabilities and fits mobile dark mode');
  assert.deepEqual((await request('/api/global-defaults')).defaults.models, before.defaults.models);
  assert.deepEqual(report.errors, []); report.passed = true;
} catch (error) {
  report.error = String(error).replaceAll(config.gateway.auth.token, '[redacted]').replace(/sk-[\w.-]+/g, '[redacted]');
  await page.screenshot({ path: join(directory, 'failure.png') }).catch(() => {}); process.exitCode = 1;
} finally {
  const current = await request('/api/global-defaults');
  if (JSON.stringify(current.defaults.models) !== JSON.stringify(before.defaults.models)) await request('/api/global-defaults', 'PATCH', { defaults: before.defaults, scope: 'models', expectedModels: current.defaults.models });
  if (savedConfigBefore.voice) await request('/api/config', 'PATCH', { voicePatchMode: 'merge', voice: { languageMode: savedConfigBefore.voice.languageMode, language: savedConfigBefore.voice.language } });
  if (originalVoice) await request('/api/config', 'PATCH', { tts: { enabled: voiceBefore.enabled, trigger: voiceBefore.trigger, providers: { 'qwen-token-plan-cn': { voice: originalVoice } } } });
  await browser.close(); await writeFile(join(directory, 'report.json'), JSON.stringify(report, null, 2)); console.log(JSON.stringify(report));
}
