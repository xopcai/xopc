# macOS Code Signing (Developer ID Application certificate)
# Option A: path to exported .p12 file
XOPC_CSC_LINK=/path/to/DeveloperIDApplication.p12
# Option B: base64-encoded p12 (for CI)
# XOPC_CSC_LINK=<base64-encoded-p12-string>

XOPC_CSC_KEY_PASSWORD=your-p12-export-password

# Apple Notarization (App-Specific Password, NOT your Apple ID password)
# Generate at: https://appleid.apple.com/account/manage → App-Specific Passwords
XOPC_APPLE_ID=your@email.com
XOPC_APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
XOPC_APPLE_TEAM_ID=XXXXXXXXXX
