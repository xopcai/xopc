# xopc Configuration
# Copy this to .env and fill in your values

# Official release build inputs. These public values identify the xopc GitHub App.
XOPC_BUILD_GITHUB_APP_CLIENT_ID=
XOPC_BUILD_GITHUB_APP_SLUG=

# Required by a remote Gateway to encrypt GitHub user tokens (32 random bytes, base64).
# Electron creates and protects this key with the operating-system credential store.
# Generate once with: openssl rand -base64 32
XOPC_CREDENTIALS_MASTER_KEY=

# ===========================================
# LLM Providers (choose one or more)
# Env names follow src/providers/env-keys.ts (pi-ai KnownProvider).
# Vendors not in that set (e.g. DashScope chat as "qwen") → use ~/.xopc/models.json.
# ===========================================

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-xxx

# Anthropic (Claude) — OAuth token takes precedence when set
ANTHROPIC_OAUTH_TOKEN=
ANTHROPIC_API_KEY=sk-ant-api-xxx

# OpenAI (GPT-4, o1)
OPENAI_API_KEY=sk-xxx

# DeepSeek
DEEPSEEK_API_KEY=sk-xxx

# Google Gemini
GOOGLE_API_KEY=xxx
GEMINI_API_KEY=xxx

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# vLLM Local Model
VLLM_API_BASE=http://localhost:8000/v1
VLLM_API_KEY=dummy

# Groq (fast inference)
GROQ_API_KEY=gsk_xxx

# xAI (Grok)
XAI_API_KEY=xai-xxx

# Kimi Coding / Moonshot
MOONSHOT_API_KEY=sk-xxx
# or: KIMI_API_KEY=sk-xxx

# Z.ai (international GLM)
ZAI_API_KEY=sk-xxx

# MiniMax — China endpoint prefers MINIMAX_CN_API_KEY
MINIMAX_API_KEY=sk-xxx
MINIMAX_CN_API_KEY=

# Vercel AI Gateway — pi-ai primary: AI_GATEWAY_API_KEY
AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=

# GitHub Copilot — see pi-ai / env-keys for full precedence
COPILOT_GITHUB_TOKEN=
GH_TOKEN=
GITHUB_TOKEN=
GITHUB_COPILOT_TOKEN=

# OpenCode / OpenCode Go
OPENCODE_API_KEY=

# AWS Bedrock
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx

# DashScope (image generation wan2.6, Alibaba TTS, STT) — service id `dashscope`
DASHSCOPE_API_KEY=

# Default Model
DEFAULT_MODEL=anthropic/claude-sonnet-4-5

# ===========================================
# Web Search
# ===========================================

# Brave Search
BRAVE_SEARCH_API_KEY=BSA-xxx

# ===========================================
# Messaging Platforms (Telegram, etc.)
# ===========================================

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-xxx
TELEGRAM_ALLOW_FROM=["123456789", "username"]

# Discord
DISCORD_BOT_TOKEN=xxx
DISCORD_ALLOW_FROM=["123456789"]

# Slack
SLACK_BOT_TOKEN=xoxb-xxx
SLACK_ALLOW_FROM=["U123456"]

# Signal
SIGNAL_CLI_PATH=/usr/bin/signal-cli
SIGNAL_ALLOW_FROM=["+1234567890"]

# ===========================================
# Server Settings
# ===========================================

HOST=0.0.0.0
PORT=18790

# ===========================================
# Workspace
# ===========================================

# Primary agent Markdown root when no config (same as XOPC_WORKSPACE); not the `agents.defaults.workspace` parent.
WORKSPACE=~/.xopc/workspace/main

# ===========================================
# Logging (optional)
# ===========================================

# Log level: trace, debug, info, warn, error
# LOG_LEVEL=info

# Enable pretty console logs (true/false)
# XOPC_PRETTY_LOGS=true

# Include complete system prompt, messages, and tools in debug logs (sensitive)
# XOPC_LOG_LLM_PAYLOAD=false

# Log file path (default: ~/.xopc/logs/xopc.log)
# XOPC_LOG_FILE=~/.xopc/logs/xopc.log

# Log retention days (default: 7)
# XOPC_LOG_RETENTION_DAYS=7

# ===========================================
# Development
# ===========================================

# Enable debug mode
# DEBUG=true

# Node environment (development, production)
# NODE_ENV=development

# Official XOPC model service endpoints (authentication uses OAuth)
XOPC_CONSOLE_URL=https://console.xopc.ai
XOPC_MODEL_ROUTER_URL=https://router.xopc.ai/v1
