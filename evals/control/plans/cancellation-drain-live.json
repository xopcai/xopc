{
  "id": "cancellation-drain-v2",
  "concurrency": 1,
  "maxWallMs": 180000,
  "maxRequests": 2,
  "modelOrigins": [
    "https://router.xopc.ai"
  ],
  "pool": {
    "generation": 1,
    "judge": 1,
    "parent": 1
  },
  "jobs": [
    {
      "id": "cancellation",
      "timeoutMs": 150000,
      "args": [
        "--import",
        "tsx",
        "scripts/verify-cloud-cancellation-live.mts",
        "--configured-models",
        "--output",
        "{output}/cancellation"
      ]
    }
  ]
}
