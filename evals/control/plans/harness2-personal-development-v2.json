{
  "id": "harness2-personal-development-v2",
  "concurrency": 1,
  "maxWallMs": 840000,
  "maxRequests": 60,
  "modelOrigins": ["https://router.xopc.ai"],
  "pool": { "generation": 3, "judge": 1, "parent": 3 },
  "jobs": [
    {
      "id": "development-baseline",
      "timeoutMs": 780000,
      "args": [
        "--import",
        "tsx",
        "scripts/personal-repair-live-benchmark.mts",
        "--configured-models",
        "--harness2-pilot",
        "--rounds",
        "1",
        "--scenarios",
        "file",
        "--output-dir",
        "{output}/development-baseline"
      ],
      "evidence": [
        {
          "path": "{output}/development-baseline/summary.json",
          "kind": "delivery",
          "benchmark": "personal-delivery",
          "evidenceClass": "live_product",
          "expected": 1
        }
      ]
    }
  ]
}
