{
  "id": "progress-tracker",
  "name": "Progress Tracker",
  "description": "Example extension demonstrating enhanced tools with streaming updates and state persistence",
  "version": "1.0.0",
  "kind": "tool",
  "main": "index.js",
  "configSchema": {
    "type": "object",
    "properties": {
      "showProgressInChat": {
        "type": "boolean",
        "default": true,
        "description": "Show progress updates in chat"
      },
      "trackHistory": {
        "type": "boolean",
        "default": true,
        "description": "Track tool execution history"
      }
    }
  },
  "engines": {
    "xopc": ">=0.0.106 <1.0.0"
  },
  "contracts": {
    "tools": [
      "long_task"
    ],
    "hooks": [
      "tool_execution_start",
      "tool_execution_end"
    ]
  }
}
