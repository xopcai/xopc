              "label": "手动配置"
            },
            "doctor.run": {
              "label": "诊断"
            }
          }
        }
      }
    }
  },
  "activation": {
    "onChannels": [
      "feishu",
      "lark"
    ],
    "onCapabilities": [
      "tool"
    ]
  },
  "setup": {
    "providers": [],
    "requiresRuntime": true
  },
  "engines": {
    "xopc": ">=0.0.106 <1.0.0"
  },
  "contracts": {
    "channels": [
      "feishu",
      "lark"
    ]
  }
}
