                "title": "域名"
              },
              "connectionMode": {
                "title": "连接模式"
              },
              "dmPolicy": {
                "title": "私聊策略"
              },
              "groupPolicy": {
                "title": "群聊策略"
              },
              "allowFrom": {
                "title": "允许的私聊发送者"
              },
              "groupAllowFrom": {
                "title": "允许的群聊发送者"
              },
              "requireMention": {
                "title": "群聊需要 @"
              },
              "renderMode": {
                "title": "渲染模式"
              },
              "streaming": {
                "title": "流式回复"
              },
              "reactionNotifications": {
