{
  "id": "synapse",
  "name": "Synapse 看板",
  "description": "人 × AI Agent 协作看板。创建意图，Agent 自动推进，你在关键节点决策。",
  "version": "0.1.0",
  "kind": "utility",
  "main": "index.js",
  "configSchema": {
    "type": "object",
    "properties": {
      "demoMode": {
        "type": "boolean",
        "default": true,
        "description": "启用演示模式（使用模拟数据）"
      },
      "autoAdvance": {
        "type": "boolean",
        "default": true,
        "description": "演示模式下自动推进进度"
      }
    }
  },
  "ui": {
    "main": "ui/panel.html",
    "icon": "ui/icon.svg",
    "permissions": [
      "theme",
      "notification",
      "storage",
      "agent.send",
      "agent.subscribe",
      "config.read",
      "config.write"
    ],
    "contributions": {
      "pages": [
        {
          "id": "synapse.board",
          "title": "Synapse 看板",
          "path": "/extensions/synapse",
          "entrypoint": "ui/panel.html",
          "showInNav": true,
          "navIcon": "columns-3"
        }
      ],
      "settingsPanels": [
        {
          "id": "synapse.settings",
          "title": "Synapse 设置",
          "entrypoint": "ui/settings.html"
        }
      ]
    }
  },
  "engines": {
    "xopc": ">=0.0.106 <1.0.0"
  },
  "contracts": {
    "tools": [
      "synapse_get_board",
      "synapse_create_card",
      "synapse_move_card",
      "synapse_update_progress",
      "synapse_add_decision",
      "synapse_resolve_decision"
    ],
    "commands": [
      "synapse:open-panel",
      "synapse:board-status"
    ],
    "hooks": [
      "tool_execution_start",
      "tool_execution_end"
    ]
  }
}
