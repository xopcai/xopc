{
  "id": "weather-service",
  "name": "Weather Service",
  "description": "Provides weather data to other extensions via typed event bus",
  "version": "1.0.0",
  "kind": "utility",
  "main": "index.js",
  "configSchema": {
    "type": "object",
    "properties": {
      "defaultCity": {
        "type": "string",
        "default": "Beijing",
        "description": "Default city for weather queries"
      },
      "apiKey": {
        "type": "string",
        "description": "Weather API key (optional)"
      }
    }
  },
  "engines": {
    "xopc": ">=0.0.106 <1.0.0"
  },
  "contracts": {
    "hooks": [
      "session_end"
    ]
  }
}
