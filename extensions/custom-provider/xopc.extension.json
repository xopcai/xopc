{
  "id": "custom-provider",
  "name": "Custom Provider Example",
  "description": "Demonstrates provider registration with custom models",
  "version": "1.0.0",
  "kind": "provider",
  "main": "index.ts",
  "providers": ["custom"],
  "providerAuthEnvVars": {
    "custom": ["CUSTOM_API_KEY"]
  },
  "modelSupport": {
    "modelPrefixes": ["custom/"]
  },
  "autoEnableWhenConfiguredProviders": ["custom"],
  "configSchema": {
    "type": "object",
    "properties": {
      "proxyUrl": {
        "type": "string",
        "default": "https://api.example.com",
        "description": "Custom API proxy URL"
      },
      "apiKey": {
        "type": "string",
        "description": "API key for the proxy"
      }
    }
  }
}
