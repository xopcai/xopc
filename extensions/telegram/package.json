{
  "name": "@xopcai/xopc-extension-telegram",
  "version": "0.0.83",
  "private": true,
  "description": "Bundled Telegram channel sources (compiled with core into dist/extensions/; not published to npm).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "abort-controller": "^3.0.0",
    "@grammyjs/runner": "^2.0.3",
    "@inquirer/prompts": "^8.4.2",
    "grammy": "^1.42.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@grammyjs/types": "^3.26.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@xopcai/xopc": "workspace:*"
  },
  "xopc": {
    "bundledChannel": {
      "export": "telegramPlugin",
      "order": 10
    }
  },
  "keywords": [
    "xopc",
    "xopc-extension",
    "telegram"
  ],
  "license": "MIT"
}
