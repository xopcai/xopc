{
  "name": "@xopcai/xopc-extension-telegram",
  "version": "0.0.1",
  "private": true,
  "description": "Bundled Telegram channel sources (compiled with core into dist/extensions/; not published to npm).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.1",
    "zod": "^3.25.76",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/types": "^3.26.0",
    "grammy": "^1.42.0"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@xopcai/xopc": "workspace:*"
  },
  "xopc": {
    "bundledChannel": {
      "export": "telegramPlugin",
      "order": 10
    }
  },
  "keywords": ["xopc", "xopc-extension", "telegram"],
  "license": "MIT"
}
