{
  "id": "hello",
  "name": "Hello World",
  "description": "A simple example extension that demonstrates the extension system",
  "version": "1.0.0",
  "kind": "utility",
  "main": "index.ts",
  "configSchema": {
    "type": "object",
    "properties": {
      "greeting": {
        "type": "string",
        "default": "Hello",
        "description": "Greeting message prefix"
      },
      "verbose": {
        "type": "boolean",
        "default": false,
        "description": "Enable verbose logging"
      }
    }
  },
  "ui": {
    "main": "ui/panel.html",
    "icon": "ui/icon.svg",
    "permissions": [
      "theme",
      "notification",
      "session.read",
      "agent.send",
      "agent.subscribe",
      "config.read",
      "config.write",
      "storage"
    ],
    "contributions": {
      "settingsPanels": [
        {
          "id": "hello.settings",
          "title": "Hello World Settings",
          "entrypoint": "ui/settings.html"
        }
      ],
      "pages": [
        {
          "id": "hello.dashboard",
          "title": "Hello",
          "path": "/apps/hello",
          "entrypoint": "ui/panel.html",
          "showInNav": true,
          "navIcon": "hand-metal"
        }
      ],
      "chatWidgets": [
        {
          "id": "hello.result-widget",
          "title": "Hello Result",
          "match": {
            "toolName": "hello"
          },
          "entrypoint": "ui/widget.html",
          "maxHeight": 200,
          "interactive": false
        }
      ],
      "commands": [
        {
          "id": "hello.greet",
          "title": "Hello: Send Greeting",
          "shortcut": "⌘⇧H"
        },
        {
          "id": "hello.open-panel",
          "title": "Hello: Open Panel",
          "opensPanel": "hello.main-panel"
        }
      ]
    }
  }
}
