{
  "id": "context-injector",
  "name": "Context Injector",
  "description": "Example extension demonstrating context hook - injects system messages before LLM calls",
  "version": "1.0.0",
  "kind": "utility",
  "main": "index.js",
  "configSchema": {
    "type": "object",
    "properties": {
      "injectedContext": {
        "type": "string",
        "default": "Remember to be concise.",
        "description": "Context to inject into every conversation"
      },
      "enableTimestamp": {
        "type": "boolean",
        "default": true,
        "description": "Inject current timestamp"
      }
    }
  },
  "engines": {
    "xopc": ">=0.0.106 <1.0.0"
  },
  "contracts": {
    "hooks": [
      "context",
      "turn_start",
      "turn_end"
    ]
  }
}
