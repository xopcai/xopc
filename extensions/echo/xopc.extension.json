{
  "id": "echo",
  "name": "Echo Extension",
  "description": "Echoes messages back with modifications",
  "version": "1.0.0",
  "kind": "utility",
  "main": "index.js",
  "configSchema": {
    "type": "object",
    "properties": {
      "prefix": {
        "type": "string",
        "default": "[Echo]",
        "description": "Prefix to add to messages"
      },
      "uppercase": {
        "type": "boolean",
        "default": false,
        "description": "Convert message to uppercase"
      },
      "reverse": {
        "type": "boolean",
        "default": false,
        "description": "Reverse the message"
      }
    }
  },
  "engines": {
    "xopc": ">=0.0.106 <1.0.0"
  },
  "contracts": {
    "tools": [
      "echo"
    ],
    "hooks": [
      "message_sending",
      "message_received"
    ]
  }
}
