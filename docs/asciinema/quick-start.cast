[0.567, "o", "\u001b[36m\r\n🚀 Welcome to xopc setup!\r\n\u001b[0m\r\n"]
[0.000, "o", "══════════════════════════════════════════════════\r\n"]
[0.051, "o", "\r\n🤖 Step: AI Model\r\n\r\n"]
[0.009, "o", "\u001b[34m?\u001b[39m \u001b[1mSelect provider:\u001b[22m\r\n\u001b[36m❯ Anthropic Claude\u001b[39m\r\n  DeepSeek\r\n  Google Gemini\r\n  Groq (Fast Inference)\r\n  Kimi For Coding\r\n  MiniMax\r\n  MiniMax CN\r\n\r\n\u001b[1m↑↓\u001b[22m \u001b[2mnavigate\u001b[22m\u001b[2m • \u001b[22m\u001b[1m⏎\u001b[22m \u001b[2mselect\u001b[22m\u001b[?25l\u001b[23G"]
[1.223, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[34m?\u001b[39m \u001b[1mSelect provider:\u001b[22m\r\n  Anthropic Claude\r\n\u001b[36m❯ DeepSeek\u001b[39m\r\n  Google Gemini\r\n  Groq (Fast Inference)\r\n  Kimi For Coding\r\n  MiniMax\r\n  MiniMax CN\r\n\r\n\u001b[1m↑↓\u001b[22m \u001b[2mnavigate\u001b[22m\u001b[2m • \u001b[22m\u001b[1m⏎\u001b[22m \u001b[2mselect\u001b[22m\u001b[?25l\u001b[23G"]
[0.309, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[32m✔\u001b[39m \u001b[1mSelect provider:\u001b[22m \u001b[36mDeepSeek\u001b[39m\u001b[28G"]
[0.001, "o", "\r\n\u001b[G\u001b[?25h"]
[0.001, "o", "\r\n\u001b[32m✓\u001b[0m Found API key for DeepSeek in environment\r\n"]
[0.000, "o", "\r\n📋 Available models for DeepSeek:\r\n"]
[0.001, "o", "\u001b[34m?\u001b[39m \u001b[1mSelect model:\u001b[22m\r\n\u001b[36m❯ DeepSeek V4 Flash\u001b[39m\r\n  DeepSeek V4 Pro\r\n\r\n\u001b[1m↑↓\u001b[22m \u001b[2mnavigate\u001b[22m\u001b[2m • \u001b[22m\u001b[1m⏎\u001b[22m \u001b[2mselect\u001b[22m\u001b[?25l\u001b[23G"]
[1.533, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[32m✔\u001b[39m \u001b[1mSelect model:\u001b[22m \u001b[36mDeepSeek V4 Flash\u001b[39m\u001b[34G"]
[0.000, "o", "\r\n\u001b[G\u001b[?25h"]
[0.040, "o", "\r\n✅ Model configured: deepseek/deepseek-v4-flash\r\n"]
[0.001, "o", "\u001b[90m\r\nChannel onboarding: telegram, weixin, feishu, dingtalk\r\n\u001b[0m\r\n"]
[0.000, "o", "\r\n💬 Channel setup\r\n\r\n"]
[0.000, "o", "══════════════════════════════════════════════════\r\n"]
[0.001, "o", "\u001b[34m?\u001b[39m \u001b[1mSelect a channel to configure:\u001b[22m\r\n\u001b[36m❯ Telegram       [not configured]\u001b[39m\r\n  Weixin         [not configured]\r\n  Feishu         [not configured]\r\n  DingTalk       [not configured]\r\n  [Done]\r\n\r\n\u001b[36mTelegram Bot API (GrammY)\u001b[39m\r\n\u001b[1m↑↓\u001b[22m \u001b[2mnavigate\u001b[22m\u001b[2m • \u001b[22m\u001b[1m⏎\u001b[22m \u001b[2mselect\u001b[22m\u001b[?25l\u001b[23G"]
[0.685, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[34m?\u001b[39m \u001b[1mSelect a channel to configure:\u001b[22m\r\n  Telegram       [not configured]\r\n\u001b[36m❯ Weixin         [not configured]\u001b[39m\r\n  Feishu         [not configured]\r\n  DingTalk       [not configured]\r\n  [Done]\r\n\r\n\u001b[36mWeChat via Tencent ilink bot API (QR login, direct chat).\u001b[39m\r\n\u001b[1m↑↓\u001b[22m \u001b[2mnavigate\u001b[22m\u001b[2m • \u001b[22m\u001b[1m⏎\u001b[22m \u001b[2mselect\u001b[22m\u001b[?25l\u001b[23G"]
[0.181, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[34m?\u001b[39m \u001b[1mSelect a channel to configure:\u001b[22m\r\n  Telegram       [not configured]\r\n  Weixin         [not configured]\r\n\u001b[36m❯ Feishu         [not configured]\u001b[39m\r\n  DingTalk       [not configured]\r\n  [Done]\r\n\r\n\u001b[36mFeishu/Lark enterprise messaging (Socket Mode).\u001b[39m\r\n\u001b[1m↑↓\u001b[22m \u001b[2mnavigate\u001b[22m\u001b[2m • \u001b[22m\u001b[1m⏎\u001b[22m \u001b[2mselect\u001b[22m\u001b[?25l\u001b[23G"]
[0.174, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[34m?\u001b[39m \u001b[1mSelect a channel to configure:\u001b[22m\r\n  Telegram       [not configured]\r\n  Weixin         [not configured]\r\n  Feishu         [not configured]\r\n\u001b[36m❯ DingTalk       [not configured]\u001b[39m\r\n  [Done]\r\n\r\n\u001b[36mDingTalk enterprise robot via Stream mode (QR app registration).\u001b[39m\r\n\u001b[1m↑↓\u001b[22m \u001b[2mnavigate\u001b[22m\u001b[2m • \u001b[22m\u001b[1m⏎\u001b[22m \u001b[2mselect\u001b[22m\u001b[?25l\u001b[23G"]
[0.175, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[34m?\u001b[39m \u001b[1mSelect a channel to configure:\u001b[22m\r\n  Telegram       [not configured]\r\n  Weixin         [not configured]\r\n  Feishu         [not configured]\r\n  DingTalk       [not configured]\r\n\u001b[36m❯ [Done]\u001b[39m\r\n\r\n\u001b[36mSave and exit channel setup\u001b[39m\r\n\u001b[1m↑↓\u001b[22m \u001b[2mnavigate\u001b[22m\u001b[2m • \u001b[22m\u001b[1m⏎\u001b[22m \u001b[2mselect\u001b[22m\u001b[?25l\u001b[23G"]
[0.302, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[32m✔\u001b[39m \u001b[1mSelect a channel to configure:\u001b[22m \u001b[36m[Done]\u001b[39m\u001b[40G"]
[0.000, "o", "\r\n\u001b[G\u001b[?25h"]
[0.000, "o", "\r\n✅ Channel setup complete\r\n\r\n"]
[0.000, "o", "\u001b[36m\r\n🌐 Gateway WebUI\r\n\u001b[0m\r\n\u001b[90mApplying defaults from config schema (127.0.0.1:18790, token auth; token generated if missing).\r\n\u001b[0m\r\n"]
[0.001, "o", "✅ Gateway defaults applied.\r\n\r\n"]
[0.015, "o", "\r\n══════════════════════════════════════════════════\r\n\r\n🎉 Setup Complete!\r\n\r\n"]
[0.000, "o", "🌐 Web console (browser) — start here\r\n   Open: http://127.0.0.1:18790\r\n   Token: ebdede5d...8ab5cc8d\r\n   Bookmark link (token is saved in the browser when you open it):\r\n   http://127.0.0.1:18790?token=ebdede5d48724d5e408bc5b6eea06010b7c98ebf8ab5cc8d\r\n\r\n🚀 Next steps:\r\n  1. Choose how to launch below (gateway or terminal UI)\r\n"]
[0.000, "o", "  2. Or chat with: xopc agent -i\r\n  3. Optional: read BOOTSTRAP.md in your workspace for workspace tips\r\n\r\n"]
[0.000, "o", "📝 Usage:\r\n  xopc agent -m \"Hello\"    # Chat with AI\r\n  xopc agent -i            # Interactive mode\r\n  xopc models list         # List models\r\n"]
[0.000, "o", "  xopc auth list           # View authentication\r\n"]
[0.000, "o", "\r\n📁 Files:\r\n"]
[0.000, "o", "  Config: /Users/micjoyce/.xopc/xopc.json\r\n  Workspace: /Users/micjoyce/.xopc/workspace/main\r\n  Bootstrap: /Users/micjoyce/.xopc/workspace/main/BOOTSTRAP.md\r\n"]
[0.000, "o", "\r\n"]
[0.001, "o", "\u001b[34m?\u001b[39m \u001b[1mHow do you want to launch xopc now?\u001b[22m\r\n\u001b[36m❯ Terminal UI (embedded)\u001b[39m\r\n  Gateway WebUI (background)\r\n  Exit — I will start manually\r\n\r\n\u001b[36mxopc tui --local — no gateway process required\u001b[39m\r\n\u001b[1m↑↓\u001b[22m \u001b[2mnavigate\u001b[22m\u001b[2m • \u001b[22m\u001b[1m⏎\u001b[22m \u001b[2mselect\u001b[22m\u001b[?25l\u001b[23G"]
[1.025, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[32m✔\u001b[39m \u001b[1mHow do you want to launch xopc now?\u001b[22m \u001b[36mTerminal UI (embedded)\u001b[39m\u001b[61G"]
[0.001, "o", "\r\n\u001b[G\u001b[?25h"]
[0.000, "o", "\u001b[90m\r\n💡 Weixin is not logged in yet. When ready run: xopc channels login --channel weixin\r\n\u001b[0m\r\n"]
[0.039, "o", "\u001b[?2004h"]
