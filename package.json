{
  "name": "@xopcai/xopc",
  "version": "0.0.48",
  "description": "The OPC workstation that grows with you: AI assistant for One Person Companies — CLI, gateway, multi-channel (Telegram/WeChat), 20+ LLM providers via pi-ai, extensions and skills.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./extension-sdk": {
      "types": "./dist/src/extensions/sdk/index.d.ts",
      "import": "./dist/src/extensions/sdk/index.js",
      "default": "./dist/src/extensions/sdk/index.js"
    },
    "./extension-sdk/*": "./dist/src/extensions/sdk/*",
    "./*": "./dist/src/*"
  },
  "bin": {
    "xopc": "./dist/src/cli/bin.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:bundled-channels": "node scripts/generate-bundled-channel-plugins.mjs",
    "generate:bundled-image-providers": "node scripts/generate-bundled-image-providers.mjs",
    "generate:bundled": "pnpm run generate:bundled-channels && pnpm run generate:bundled-image-providers",
    "build:node": "node scripts/tsdown-build.mjs",
    "build:types": "tsc -p tsconfig.dts.json",
    "build:ci": "pnpm run generate:bundled && pnpm run build:node && pnpm run build:web",
    "build": "pnpm run generate:bundled && pnpm run build:node && pnpm run build:types && pnpm run build:web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:web": "pnpm -C web run build",
    "dev:web": "pnpm -C web run dev",
    "dev": "tsx src/cli/bin.ts",
    "start": "node dist/src/cli/bin.js",
    "test": "vitest run src extensions/telegram/src extensions/feishu/src extensions/dingtalk/src extensions/openai/src extensions/dashscope/src extensions/minimax/src extensions/google/src extensions/fal/src",
    "test:skills": "vitest run src/agent/skills/__tests__",
    "test:skills:regression": "./scripts/test-skills.sh",
    "test:skills:all": "npm run test:skills && npm run test:skills:regression",
    "skills:test": "tsx src/cli/bin.ts skills test",
    "skills:validate": "tsx src/cli/bin.ts skills test validate",
    "skills:security": "tsx src/cli/bin.ts skills test security",
    "lint": "eslint && pnpm -C web run lint",
    "release:patch": "bash scripts/release-patch.sh",
    "prepublishOnly": "npm test && npm run test:skills:all && npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:extension-sdk": "pnpm -C packages/extension-ui-sdk run docs",
    "build:extensions-ui": "node scripts/build-extensions-ui.mjs",
    "electron:dev": "cross-env ELECTRON_ENTRY=out/main/index.js electron-vite dev",
    "electron:vite:build": "cross-env ELECTRON_ENTRY=out/main/index.js electron-vite build",
    "electron:package": "node scripts/electron-builder.mjs",
    "electron:server:build": "node scripts/build-electron-server.mjs",
    "electron:build": "pnpm run electron:vite:build && pnpm run electron:server:build && pnpm run electron:package",
    "electron:preview": "cross-env ELECTRON_ENTRY=out/main/index.js electron-vite preview"
  },
  "keywords": [
    "ai",
    "agent",
    "chatbot",
    "personal-assistant",
    "llm",
    "openai",
    "claude",
    "telegram",
    "automation"
  ],
  "author": "xopcai <lyxopc.ai@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xopcai/xopc.git"
  },
  "bugs": {
    "url": "https://github.com/xopcai/xopc/issues"
  },
  "homepage": "https://github.com/xopcai/xopc#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "happy-dom": "^20.8.9",
      "protobufjs": "^7.5.5",
      "fast-xml-parser": "^5.5.7",
      "fast-xml-builder": ">=1.1.7",
      "flatted": "^3.4.2",
      "lodash": "^4.18.0",
      "@xmldom/xmldom": "^0.8.12",
      "defu": "^6.1.5",
      "basic-ftp": "^5.3.1",
      "picomatch": "^4.0.4",
      "vitepress>vite": "5.4.21",
      "axios": "^1.15.1"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "electron"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/types": "^3.26.0",
    "@hono/node-server": "^2.0.0",
    "@inquirer/prompts": "^8.4.2",
    "@larksuiteoapi/node-sdk": "^1.39.0",
    "@mozilla/readability": "^0.6.0",
    "@sinclair/typebox": "^0.34.49",
    "@vscode/ripgrep": "^1.17.1",
    "abort-controller": "^3.0.0",
    "adm-zip": "^0.5.17",
    "chalk": "^5.6.2",
    "chromium-bidi": "15.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "cron-parser": "^5.5.0",
    "dingtalk-stream": "^2.1.4",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "glob": "^13.0.6",
    "grammy": "^1.42.0",
    "hono": "^4.12.15",
    "jiti": "^2.6.1",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.0.2",
    "markdown-it": "^14.1.1",
    "node-cron": "^4.2.1",
    "node-edge-tts": "^1.2.10",
    "openai": "^6.34.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright-core": "^1.59.1",
    "proper-lockfile": "^4.1.2",
    "qrcode-terminal": "^0.12.0",
    "semver": "^7.8.0",
    "silk-wasm": "^3.7.1",
    "thread-stream": "^4.0.0",
    "undici": "^8.1.0",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/adm-zip": "^0.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "tailwindcss": "^4.2.4",
    "tsdown": "0.21.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10",
    "vitepress": "^1.6.4",
    "vitest": "4.1.5",
    "vue": "^3.5.33"
  }
}
