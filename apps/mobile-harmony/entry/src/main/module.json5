{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:app_description",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [{
      "name": "EntryAbility",
      "srcEntry": "./ets/entryability/EntryAbility.ets",
      "description": "$string:app_description",
      "icon": "$media:app_icon",
      "label": "$string:app_name",
      "startWindowIcon": "$media:launch_logo",
      "startWindowBackground": "$color:surface",
      "exported": true,
      "launchType": "singleton",
      "backgroundModes": ["audioPlayback", "audioRecording"],
      "skills": [
        { "entities": ["entity.system.home"], "actions": ["ohos.want.action.home"] },
        { "entities": ["entity.system.browsable"], "actions": ["ohos.want.action.viewData"],
          "uris": [{ "scheme": "xopc", "host": "notification" }] },
        { "actions": ["ohos.want.action.viewData"], "uris": [
          { "scheme": "file", "type": "image/*" },
          { "scheme": "file", "type": "application/pdf" },
          { "scheme": "file", "type": "text/*" },
          { "scheme": "file", "type": "application/json" },
          { "scheme": "file", "type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document" },
          { "scheme": "file", "type": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" },
          { "scheme": "file", "type": "application/vnd.openxmlformats-officedocument.presentationml.presentation" }
        ] }
      ]
    }, {
      "name": "PushMessageAbility",
      "srcEntry": "./ets/entryability/PushMessageAbility.ets",
      "launchType": "singleton",
      "exported": false,
      "startWindowIcon": "$media:launch_logo",
      "startWindowBackground": "$color:surface",
      "skills": [{ "actions": ["action.ohos.push.listener"] }]
    }],
    "extensionAbilities": [{
      "name": "ShareExtensionAbility",
      "srcEntry": "./ets/entryability/ShareExtensionAbility.ets",
      "type": "share",
      "description": "$string:share_intake_description",
      "icon": "$media:app_icon",
      "label": "$string:app_name",
      "exported": true,
      "skills": [{
        "actions": ["ohos.want.action.sendData"],
        "uris": [
          { "scheme": "file", "utd": "general.text", "maxFileSupported": 10 },
          { "scheme": "file", "utd": "general.plain-text", "maxFileSupported": 10 },
          { "scheme": "file", "utd": "general.hyperlink", "maxFileSupported": 1 },
          { "scheme": "file", "utd": "general.image", "maxFileSupported": 10 },
          { "scheme": "file", "utd": "com.adobe.pdf", "maxFileSupported": 10 },
          { "scheme": "file", "utd": "org.openxmlformats.wordprocessingml.document", "maxFileSupported": 10 },
          { "scheme": "file", "utd": "org.openxmlformats.spreadsheetml.sheet", "maxFileSupported": 10 },
          { "scheme": "file", "utd": "org.openxmlformats.presentationml.presentation", "maxFileSupported": 10 }
        ]
      }]
    }],
    "requestPermissions": [
      { "name": "ohos.permission.READ_CALENDAR", "reason": "$string:calendar_reason", "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      { "name": "ohos.permission.APPROXIMATELY_LOCATION", "reason": "$string:location_reason", "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      { "name": "ohos.permission.LOCATION", "reason": "$string:location_reason", "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.KEEP_BACKGROUND_RUNNING" },
      { "name": "ohos.permission.MICROPHONE", "reason": "$string:microphone_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } }
    ]
  }
}
