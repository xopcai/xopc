/** Note content category returned by the Gateway. */
export type XopcNoteKind = 'thought' | 'todo' | 'voice' | 'media' | 'bookmark' | 'mixed' | 'task';

/** Note lifecycle state returned by the Gateway. */
export type XopcNoteStatus = 'inbox' | 'processed' | 'archived' | 'trashed';

/** Local synchronization state for an editable draft. */
export type XopcNoteSyncState = 'clean' | 'dirty' | 'saving' | 'offline' | 'conflict';

/** Capture provenance attached to a note. */
export interface XopcNoteCaptureSource {
  /** Gateway capture channel. */
  channel: string;
  /** Native platform when the note came from a mobile client. */
  platform?: string;
}

/** Attachment metadata; binary content remains outside the editor document. */
export interface XopcNoteAttachment {
  /** Stable attachment identifier. */
  id: string;
  /** Attachment media category. */
  type: 'image' | 'video' | 'audio' | 'file';
  /** MIME type reported by the Gateway. */
  mimeType: string;
  /** User-facing file name. */
  fileName: string;
  /** Size in bytes. */
  size: number;
  /** Gateway-relative storage path. */
  relativePath: string;
  /** Optional speech or document transcript. */
  transcript?: string;
  /** Optional media duration in seconds. */
  duration?: number;
}

/** Task metadata used when a note represents a task. */
export interface XopcNoteTaskMeta {
  /** Whether the task has been completed. */
  done: boolean;
  /** Optional due timestamp in milliseconds. */
  dueAt?: number;
  /** Optional task priority. */
  priority?: 'high' | 'medium' | 'low';
}

/** Full note document returned by the detail endpoint. */
export interface XopcNote {
  /** Stable note identifier. */
  id: string;
  /** Optional explicit title. */
  title?: string;
  /** Semantic note kind. */
  kind: XopcNoteKind;
  /** Lifecycle state. */
  status: XopcNoteStatus;
  /** Canonical Markdown content. */
  markdown: string;
  /** Attached media metadata. */
  attachments?: XopcNoteAttachment[];
  /** Creation timestamp in milliseconds. */
  createdAt: number;
  /** Last update timestamp in milliseconds. */
  updatedAt: number;
  /** Capture provenance. */
  capturedVia: XopcNoteCaptureSource;
  /** User-managed tags. */
  tags?: string[];
  /** Whether the note is pinned. */
  pinned?: boolean;
  /** Client-side edit counter. */
  localVersion?: number;
  /** Authoritative optimistic-concurrency revision. */
  remoteVersion?: number;
  /** Optional note group. */
  groupId?: string;
  /** Optional last-open timestamp. */
  lastOpenedAt?: number;
  /** Optional task state. */
  taskMeta?: XopcNoteTaskMeta;
}

/** Lightweight list entry returned by the list endpoint. */
export interface XopcNoteIndexEntry {
  /** Stable note identifier. */
  id: string;
  /** Optional explicit title. */
  title?: string;
  /** Semantic note kind. */
  kind: XopcNoteKind;
  /** Lifecycle state. */
  status: XopcNoteStatus;
  /** Creation timestamp in milliseconds. */
  createdAt: number;
  /** Last update timestamp in milliseconds. */
  updatedAt: number;
  /** Whether the note is pinned. */
  pinned?: boolean;
  /** User-managed tags. */
  tags?: string[];
  /** Plain-text preview generated by the Gateway. */
  snippet?: string;
  /** Optional note group. */
  groupId?: string;
  /** Optional last-open timestamp. */
  lastOpenedAt?: number;
  /** Task completion state for task notes. */
  taskDone?: boolean;
  /** Task due timestamp for task notes. */
  taskDueAt?: number;
}

/** Paginated list response. */
export interface XopcNoteList {
  /** Current page items. */
  items: XopcNoteIndexEntry[];
  /** Total matching entries. */
  total?: number;
  /** Whether another page is available. */
  hasMore?: boolean;
}

/** Detail response wrapper. */
export interface XopcNoteResult {
  /** Loaded note. */
  note: XopcNote;
}

/** Note revision attached to a dedicated conversation. */
export interface XopcNoteSourceBinding {
  /** Bound source category. */
  kind: 'note';
  /** Bound note identifier. */
  sourceId: string;
  /** Note revision visible to the conversation. */
  version: string;
  /** Binding timestamp in milliseconds. */
  attachedAt: number;
}

/** Result returned when opening the persistent conversation for a note. */
export interface XopcNoteConversationResult {
  /** Stable conversation identifier reused across later visits. */
  conversationId: string;
  /** Whether an existing note conversation was reused. */
  reused: boolean;
  /** Authoritative note binding applied to the conversation. */
  sourceBinding: XopcNoteSourceBinding;
}

/** Editable draft persisted locally before remote synchronization. */
export interface XopcNoteDraft {
  /** Note identifier or local placeholder identifier. */
  noteId: string;
  /** Editable title. */
  title: string;
  /** Editable canonical Markdown. */
  markdown: string;
  /** Remote revision from which this draft was created. */
  baseRevision: number;
  /** Monotonic local edit counter. */
  localVersion: number;
  /** Latest local mutation timestamp. */
  updatedAt: number;
  /** Synchronization state. */
  syncState: XopcNoteSyncState;
  /** Stable mutation identifier for safe create retries. */
  mutationId: string;
}

/** Result of the local-first sync endpoint. */
export interface XopcNoteSyncResult {
  /** Whether the server rejected the draft due to a stale base revision. */
  conflict: boolean;
  /** Current server note. */
  note: XopcNote;
}

/** Replaces a Markdown range. */
export interface XopcNoteReplaceRangeOperation { type: 'replaceRange'; from: number; to: number; markdown: string; }
/** Inserts Markdown at an offset. */
export interface XopcNoteInsertOperation { type: 'insertAt'; offset: number; markdown: string; }
/** Replaces a heading section. */
export interface XopcNoteReplaceSectionOperation { type: 'replaceSection'; sectionId: string; markdown: string; }
/** Appends a heading section. */
export interface XopcNoteAppendSectionOperation { type: 'appendSection'; heading: string; markdown: string; }
/** Prepends a heading section. */
export interface XopcNotePrependSectionOperation { type: 'prependSection'; heading: string; markdown: string; }
/** Updates note metadata. */
export interface XopcNoteUpdateMetadataOperation {
  type: 'updateMetadata'; title?: string; tags?: string[]; status?: XopcNoteStatus;
}
/** A single AI patch operation. */
export type XopcNotePatchOperation = XopcNoteReplaceRangeOperation | XopcNoteInsertOperation
  | XopcNoteReplaceSectionOperation | XopcNoteAppendSectionOperation | XopcNotePrependSectionOperation
  | XopcNoteUpdateMetadataOperation;

/** Mutable note metadata accepted by the update endpoint. */
export interface XopcNoteMetadataPatch { pinned?: boolean; status?: XopcNoteStatus; tags?: string[]; }

/** Previewable AI edit proposal. */
export interface XopcNoteAiPatch {
  /** Stable patch identifier. */
  id: string;
  /** Human-readable summary. */
  summary: string;
  /** Deterministic operations applied outside the editor engine. */
  operations: XopcNotePatchOperation[];
}

/** AI edit endpoint response. */
export interface XopcNoteAiEditResult {
  /** Assistant explanation. */
  message: string;
  /** Previewable patch. */
  patch: XopcNoteAiPatch;
}

/** History list entry. */
export interface XopcNoteHistoryEntry {
  /** Snapshot timestamp. */
  timestamp: number;
  /** Mutation source. */
  trigger: 'edit' | 'ai_edit' | 'sync' | 'restore';
  /** Optional snapshot preview. */
  snippet?: string;
}

/** History endpoint response. */
export interface XopcNoteHistoryResult {
  /** Available snapshots in server order. */
  entries: XopcNoteHistoryEntry[];
}

/** Full historical snapshot. */
export interface XopcNoteSnapshot {
  /** Source note identifier. */
  noteId: string;
  /** Snapshot timestamp. */
  timestamp: number;
  /** Mutation source. */
  trigger: 'edit' | 'ai_edit' | 'sync' | 'restore';
  /** Optional title at that revision. */
  title?: string;
  /** Markdown at that revision. */
  markdown: string;
  /** Tags at that revision. */
  tags?: string[];
  /** Note kind at that revision. */
  kind: XopcNoteKind;
  /** Note status at that revision. */
  status: XopcNoteStatus;
}
